// core <-> Card worker protocol. Independent from the external RPC.
// Frames: 4 byte little-endian length + FlatBuffer.
//
// One call at a time per worker. call_id >= 1 and never reused by a worker.
// A call ends with exactly one WorkerResult or WorkerFailure. View relay
// messages use call_id 0 and are independent of calls.

include "card.fbs";
include "worker_types.fbs";

namespace Tsugumi.Worker;
attribute "trace_secret";

table EnvVar {
  name:string (id: 0, required);
  value:string (id: 1, required, trace_secret);
}

// A declared output: the worker checks names and required presence.
table WorkerPort {
  name:string (id: 0, required);
  required:bool (id: 1);
}

// The worker never opens input or output bytes.
table WorkerCall {
  inputs:[Tsugumi.Card.CardPort] (id: 0, required);
  outputs:[WorkerPort] (id: 1, required);
  // Remaining time in milliseconds. Omitted means no deadline.
  deadline_ms:uint64 = null (id: 2);
  artifact_directory:string (id: 3);
  // Before replying, forward displays queued before a one-shot call returned.
  drain_display:bool (id: 4);
}

table WorkerOutput {
  name:string (id: 0, required);
  bytes:[ubyte] (id: 1);
}

// An artifact the supervisor created during the call. Its position in the
// list is its directory name under the call's artifact directory.
table CreatedArtifact {
  id:tsugumi.ArtifactId (id: 0, required);
  keep:bool (id: 1);
}

// The supervisor fills `created` itself; the Card's process leaves it empty.
table WorkerResult {
  outputs:[WorkerOutput] (id: 0, required);
  created:[CreatedArtifact] (id: 1);
}

table WorkerFailure {
  failure:Tsugumi.Data.Failure (id: 0, required);
  created:[CreatedArtifact] (id: 1);
}

// The supervisor allocates a random id and the next directory number; the
// Card's process makes `<artifact_directory>/<counter>`. No id = refused.
table WorkerArtifactCreate { flags:uint; }
table WorkerArtifactCreated { id:tsugumi.ArtifactId; counter:ulong; }
// The supervisor resolves any sealed artifact of the project by its id.
table WorkerArtifactOpen { id:tsugumi.ArtifactId (required); }
table WorkerArtifactOpened { path:string; }

table WorkerCancel {}

// A private launch frame sent before the first call when the Card uses secrets.
table WorkerStart { environment:[EnvVar] (required); }

struct ViewUuid { bytes:[ubyte:16]; }
enum ViewEventKind:ubyte { Message, Close }
enum ViewControlKind:ubyte { Open, Register, Unregister }

table WorkerDisplay {
  session:ViewUuid (required);
  bytes:[ubyte] (required);
}

table WorkerViewEvent {
  kind:ViewEventKind;
  route:ViewUuid (required);
  session:ViewUuid (required);
  bytes:[ubyte];
}

// Incremental credit: bytes freed for an outbound session or inbound route.
table WorkerDisplayCredit {
  address:ViewUuid (required);
  bytes:uint32;
}

// One outstanding request per process. IDs start at 1 and increase.
table WorkerViewRequest {
  request_id:ulong;
  kind:ViewControlKind;
  view:string;
  mode:uint;
  width:uint;
  height:uint;
  session:ViewUuid;
  route:ViewUuid;
  flags:uint;
}

table WorkerViewReply {
  request_id:ulong;
  ok:bool;
  session:ViewUuid;
  route:ViewUuid;
}

union WorkerPayload {
  WorkerCall = 1,
  WorkerResult = 2,
  WorkerFailure = 3,
  WorkerCancel = 4,
  WorkerDisplay = 5,
  WorkerStart = 6,
  WorkerDisplayCredit = 7,
  WorkerArtifactOpen = 8,
  WorkerArtifactOpened = 9,
  WorkerViewEvent = 10,
  WorkerViewRequest = 11,
  WorkerViewReply = 12,
  WorkerArtifactCreate = 13,
  WorkerArtifactCreated = 14,
}

table WorkerMessage {
  call_id:uint64 = null (id: 0);
  value:WorkerPayload (id: 2);
}

root_type WorkerMessage;
file_identifier "TSW1";
