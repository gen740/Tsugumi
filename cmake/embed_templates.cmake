# Embed the one host catalog, assembled from the shared template sources.
set(catalog "{}")
foreach(group basic input/Sources/InputTemplates/inputs visualization reports)
  file(READ ${INPUT_DIR}/${group}.json data)
  string(JSON count LENGTH "${data}")
  math(EXPR last "${count} - 1")
  foreach(i RANGE ${last})
    string(JSON name MEMBER "${data}" ${i})
    string(JSON files GET "${data}" ${name})
    string(JSON catalog SET "${catalog}" ${name} "${files}")
  endforeach()
endforeach()
foreach(name csharp marimo go rust)
  file(READ ${INPUT_DIR}/${name}.json data)
  string(JSON catalog SET "${catalog}" ${name} "${data}")
endforeach()
set(INPUT ${OUTPUT}.json)
file(WRITE ${INPUT} "${catalog}")
set(SYMBOL tsugumi_host_templates)
include(${CMAKE_CURRENT_LIST_DIR}/embed.cmake)
