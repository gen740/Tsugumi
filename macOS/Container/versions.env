# Pinned versions for the Tsugumi container environment.
# Apple container CLI/runtime the launcher is validated against:
TSUGUMI_CONTAINER_VERSION=0.6.0
# Minimum macOS: Apple container 0.6 requires macOS 26.
TSUGUMI_MIN_MACOS=26.0
# Builder image used only to produce the environment image.
TSUGUMI_BUILDER_IMAGE=docker.io/nixos/nix:2.31.2
# Environment image produced by image.nix.
TSUGUMI_IMAGE=tsugumi-env
TSUGUMI_IMAGE_TAG=1.0.0
