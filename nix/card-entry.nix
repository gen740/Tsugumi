# Generated by tsugumid. Evaluated in restricted mode without IFD.
#
# A Card's default.nix receives exactly { pkgs, params, inputs, schemas }:
# inputs.<port> is the exports set of the guaranteed producer of that input,
# shared by all run implementations and imported lazily; inputs.tsugumi is the
# pinned kit imported with this Card's pkgs, passed through unchanged;
# inputs.sources.<name> holds the packages of a flake the project declares in
# nixSources, read only when the Card's evaluation uses it; schemas is a store
# directory with _inputs.fbs, _outputs.fbs and _params.fbs of the current
# definition and wiring.
pkgs: readSource:
{
  nixDir,
  gen,
  upstream,
  card,
  needsWorker ? false,
  viewsOnly ? false,
}:

let
  # upstream.json names folders of this evaluator and is read only here.
  up = builtins.fromJSON (builtins.readFile upstream);
  tsugumi = import (nixDir + "/kit") { inherit pkgs; };
  # What Tsugumi evaluated apart from this evaluator: built when a Card uses it.
  sourceReaders.flake = v: {
    inherit (v) ref rev narHash;
    packages = builtins.mapAttrs (
      _: p:
      let
        package = {
          override =
            _:
            throw "External package functions stay in their source evaluator. Set nixSources[].overrides.<package>.override in tsugumi.json (JSON arguments). packages already selects the target system.";
          overrideAttrs =
            _:
            throw "Set nixSources[].overrides.<package>.overrideAttrs in tsugumi.json (JSON attributes; a pinned fetch is { fetchurl = { url; sha256; }; }). Functions cannot cross the source evaluator boundary.";
          type = "derivation";
          inherit (p) name;
          outputName = p.output;
          outputs = [ p.output ];
          drvPath = builtins.appendContext p.drv {
            ${p.drv} = {
              allOutputs = true;
            };
          };
          outPath = builtins.appendContext p.out {
            ${p.drv} = {
              outputs = [ p.output ];
            };
          };
          ${p.output} = package;
        };
      in
      package
    ) v.packages;
  };
  # tsugumid evaluates a declared flake the first time this is forced.
  sourcesOf =
    g:
    builtins.listToAttrs (
      map (s: {
        name = s.name;
        value = sourceReaders.${s.type} (readSource {
          inherit (s) name ref overrides;
        });
      }) (builtins.fromJSON (builtins.readFile (g + "/sources.json")))
    );
  argumentsFor = g: deps: {
    inherit pkgs;
    params = builtins.fromJSON (builtins.readFile (g + "/params-nix.json"));
    inputs = inputsFor g deps;
    schemas = builtins.path {
      path = g + "/schemas";
      name = "tsugumi-card-schemas";
    };
  };
  inputsFor =
    g: deps:
    builtins.listToAttrs (
      map (d: {
        name = d.name;
        value = cards.${d.key}.exports or { };
      }) deps
    )
    // {
      inherit tsugumi;
      sources = sourcesOf g;
    };
  importCard = u: import (/. + u.def + "/default.nix") (argumentsFor (/. + u.gen) u.deps);
  cards = builtins.listToAttrs (
    map (u: {
      name = u.key;
      value = importCard u;
    }) up.cards
  );
  self = import (card + "/default.nix") (argumentsFor gen up.deps);
  unknown = pkgs.lib.subtractLists [ "run" "views" "exports" ] (builtins.attrNames self);
  run = self.run or (throw "a Card needs run");
  executionList = viewsOnly || builtins.isList run;
  entries =
    if viewsOnly then
      [ ]
    else if executionList then
      run
    else
      [ run ];
  normalize =
    entry:
    if pkgs.lib.isDerivation entry then
      {
        label = "";
        run = entry;
      }
    else if
      executionList
      && builtins.isAttrs entry
      &&
        builtins.attrNames entry == [
          "label"
          "run"
        ]
      && builtins.isString entry.label
      && pkgs.lib.isDerivation entry.run
    then
      entry
    else
      throw "each run implementation must be a derivation containing lib/main.so; only run list entries can have labels";
  runs = map normalize entries;
  declarations = self.views or [ ];
  viewOf =
    view:
    assert pkgs.lib.assertMsg (
      builtins.isAttrs view
      &&
        builtins.attrNames view == [
          "blob"
          "name"
          "type"
        ]
      && builtins.isString view.name
      && builtins.elem view.type [
        "dawn"
        "html"
      ]
      && (
        builtins.isPath view.blob
        || pkgs.lib.isDerivation view.blob
        || (builtins.isString view.blob && builtins.hasContext view.blob)
      )
    ) "a Card view must declare { name; type = dawn or html; blob = a file path; }";
    let
      blob = "${view.blob}";
    in
    assert pkgs.lib.assertMsg (
      pkgs.lib.hasPrefix "${builtins.storeDir}/" blob
      && !(builtins.elem ".." (pkgs.lib.splitString "/" blob))
    ) "a Card view blob must refer to a file in the Nix store";
    {
      inherit (view) name type;
      inherit blob;
    };
in
assert pkgs.lib.assertMsg (
  unknown == [ ]
) "unknown Card attributes: ${toString unknown} (known: run views exports)";
assert pkgs.lib.assertMsg (builtins.isList declarations) "Card views must be a list";
{
  inherit executionList;
  implementationCount = builtins.length entries;
  implementationLabels = builtins.unsafeDiscardStringContext (
    builtins.toJSON (map (r: r.label) runs)
  );
  plan = pkgs.writeText "tsugumi-card-plan.json" (
    builtins.toJSON (
      {
        runs = map (r: "${r.run}") runs;
        views = map viewOf declarations;
      }
      // pkgs.lib.optionalAttrs (needsWorker && !viewsOnly) {
        worker = "${import (nixDir + "/worker/worker.nix") { inherit pkgs; }}/bin/tsugumi-worker";
      }
    )
  );
}
