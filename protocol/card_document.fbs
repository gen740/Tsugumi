// definitions/<id>/_card.json: one Card's kind and execution settings.
//
// Saved as FlatBuffers JSON text and read with the FlatBuffers parser (see
// project_document.fbs). Keys keep the document's camelCase spelling.
//
// There are no built-in defaults. Each Card type has its own set of fields
// (docs/Reference.md, "_card.json"): every field of that set without
// "Optional" in its comment must be written, and a field outside the set is a
// load error. Scalars are declared `= null` so that the core can tell a
// missing value from a written one. Whoever creates a Card writes every value.
//
//   code:         type symbol inputs maxRuns reuseWorker timeoutSeconds
//                 buildTimeoutSeconds recordLogs recordIO sandbox grants
//                 systems workerCapabilities [secrets]
//   merge:        type symbol inputs maxRuns recordIO
//   collect:      type symbol maxRuns recordIO
//   draft, trigger, subgraph: type symbol

namespace Tsugumi.Document;

/// What the Card is.
enum CardType:ubyte {
  code,
  draft,
  trigger,
  merge,
  collect,
  subgraph,
}

/// Whether a Card records: as its project says, or on or off for this Card.
enum RecordSetting:ubyte {
  project,
  on,
  off,
}

table Input {
  /// [a-z][a-z0-9_]{0,63}.
  name:string (required);
}

/// A folder the worker may read: a folder of the Mac, seen in the worker as
/// /host/<name>.
table HostFolder {
  /// Name declared in the containing project, also used under /host.
  name:string (required);
  /// false: read-only.
  write:bool = null;
}

table SandboxLimits {
  /// CPUs, in [0, 256]; 0 means no limit.
  cpu:double = null;
  /// 0 means no limit.
  memoryMiB:ulong = null;
}

table Sandbox {
  filesystem:bool = null;
  pid:bool = null;
  ipc:bool = null;
  identity:bool = null;
  limits:SandboxLimits;
}

table Grants {
  network:bool = null;
  gui:bool = null;
  /// Optional.
  hostPaths:[HostFolder];
}

table Card {
  type:CardType = null;
  /// The Card's icon (a symbol name the UIs draw), or "none" for the UI's own
  /// icon for the Card's kind.
  symbol:string (required);
  inputs:[Input];
  maxRuns:ulong = null;
  /// 0 means no limit.
  timeoutSeconds:ulong = null;
  /// 0 means no limit.
  buildTimeoutSeconds:ulong = null;
  recordLogs:RecordSetting = null;
  recordIO:RecordSetting = null;
  sandbox:Sandbox;
  grants:Grants;
  /// Keep worker state across invocations and runs.
  reuseWorker:bool = null;
  /// The Nix systems the Card works on (at least one, for example
  /// ["aarch64-linux", "x86_64-linux"]). A worker whose native system is in
  /// the set builds and runs the Card natively; any other worker runs the
  /// first entry emulated.
  systems:[string];
  /// Capability bits (0-63) a worker must have: the Card runs only on a worker
  /// whose own bits (host settings) include every bit listed here.
  workerCapabilities:[ubyte];
  /// Optional: names of the Card secrets the Card's process receives as
  /// environment variables of the same name. Values live only in hostd's
  /// secret store.
  secrets:[string];
}

root_type Card;
