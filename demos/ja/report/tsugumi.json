{
  "formatVersion": 1,
  "name": "Data to report",
  "nixPath": [
    {
      "name": "nixpkgs",
      "url": "github:NixOS/nixpkgs/nixos-unstable"
    },
    {
      "name": "tsugumi-kit",
      "url": "github:gen740/tsugumi-kit/main"
    }
  ],
  "trackedPaths": [],
  "agentExclude": [
    ".git",
    ".DS_Store"
  ],
  "recordLogs": true,
  "recordIO": false,
  "logLimitBytes": 134217728,
  "outputLimitBytes": 68719476736,
  "outputLimitEntries": 1000,
  "canvas": {
    "cards": [
      {
        "id": "start"
      },
      {
        "id": "generate"
      },
      {
        "id": "aggregate"
      },
      {
        "id": "render"
      },
      {
        "id": "archive"
      }
    ],
    "connections": [
      {
        "from": {
          "card": "generate",
          "port": "csv"
        },
        "to": {
          "card": "aggregate",
          "port": "csv"
        }
      },
      {
        "from": {
          "card": "aggregate",
          "port": "summary"
        },
        "to": {
          "card": "render",
          "port": "summary"
        }
      },
      {
        "from": {
          "card": "render",
          "port": "report"
        },
        "to": {
          "card": "archive",
          "port": "report"
        }
      },
      {
        "from": {
          "card": "start",
          "port": "out"
        },
        "to": {
          "card": "generate",
          "port": "start"
        }
      }
    ]
  }
}
