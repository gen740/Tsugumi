function(tsugumi_check_directory directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(owner ${target} TSUGUMI_OWNER)
    if(owner)
      tsugumi_check_boundary(${target})
    elseif(target MATCHES "^tsugumi")
      get_target_property(imported ${target} IMPORTED)
      get_target_property(target_type ${target} TYPE)
      if(NOT imported AND NOT target_type STREQUAL "UTILITY")
        message(FATAL_ERROR "Unassigned production target: ${target}")
      endif()
    endif()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    tsugumi_check_directory("${child}")
  endforeach()
endfunction()
tsugumi_check_directory("${PROJECT_SOURCE_DIR}")
