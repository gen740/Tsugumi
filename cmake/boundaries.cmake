# Check actual target closures after every production component is defined.
# External targets are leaves; all Tsugumi targets must be assigned an owner.
function(tsugumi_boundary target owner)
  set_property(TARGET ${target} PROPERTY TSUGUMI_OWNER "${owner}")
endfunction()
function(tsugumi_include_owner path output)
  set(result "")
  if(path MATCHES "^${PROJECT_BINARY_DIR}/generated/")
    set(result protocol)
  elseif(path MATCHES "^${PROJECT_SOURCE_DIR}/")
    file(RELATIVE_PATH path "${PROJECT_SOURCE_DIR}" "${path}")
    foreach(candidate document runtime_support runtime host store worker_contract worker util rpc client sdk protocol guest cli ui_linux)
      if(path MATCHES "^${roots_${candidate}}(/|$)")
        set(result "${candidate}")
        break()
      endif()
    endforeach()
  endif()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()
function(tsugumi_check_boundary target)
  get_target_property(owner ${target} TSUGUMI_OWNER)
  get_target_property(sources ${target} SOURCES)
  get_target_property(directory ${target} SOURCE_DIR)
  foreach(source IN LISTS sources)
    if(source STREQUAL "sources-NOTFOUND")
      continue()
    endif()
    if(source MATCHES "^\\$<")
      continue()
    endif()
    get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${directory}")
    if(source MATCHES "^${PROJECT_SOURCE_DIR}/" AND NOT source MATCHES "^${PROJECT_BINARY_DIR}/")
      file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${source}")
      if(NOT relative MATCHES "^${roots_${owner}}/")
        message(FATAL_ERROR "Source outside target ownership: ${target} (${owner}): ${relative}")
      endif()
    endif()
  endforeach()
  foreach(property INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
    get_target_property(includes ${target} ${property})
    foreach(path IN LISTS includes)
      if(path MATCHES "^\\$<")
        continue()
      endif()
      get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${directory}")
      tsugumi_include_owner("${path}" dependency)
      if(dependency AND NOT dependency IN_LIST allowed_${owner})
        message(FATAL_ERROR "Forbidden include root: ${target} (${owner}) -> ${path} (${dependency})")
      endif()
    endforeach()
  endforeach()
  get_target_property(links ${target} LINK_LIBRARIES)
  get_target_property(interface_links ${target} INTERFACE_LINK_LIBRARIES)
  foreach(link IN LISTS links interface_links)
    # Static private links are wrapped in LINK_ONLY by CMake.
    string(REGEX REPLACE "^\\$<LINK_ONLY:([^>]+)>$" "\\1" link "${link}")
    if(NOT TARGET "${link}")
      continue()
    endif()
    get_target_property(dependency ${link} TSUGUMI_OWNER)
    if(link MATCHES "^tsugumi" AND NOT dependency)
      message(FATAL_ERROR "Unassigned production dependency: ${target} -> ${link}")
    endif()
    if(dependency AND NOT dependency IN_LIST allowed_${owner})
      message(FATAL_ERROR "Forbidden production dependency: ${target} (${owner}) -> ${link} (${dependency})")
    endif()
  endforeach()
endfunction()
