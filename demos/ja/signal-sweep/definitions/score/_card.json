{
  "type": "code",
  "symbol": "chevron.left.forwardslash.chevron.right",
  "inputs": [
    {
      "name": "signal"
    }
  ],
  "maxRuns": 1,
  "reuseWorker": false,
  "timeoutSeconds": 0,
  "buildTimeoutSeconds": 0,
  "recordLogs": "project",
  "recordIO": "on",
  "sandbox": {
    "filesystem": true,
    "pid": true,
    "ipc": true,
    "identity": true,
    "limits": {
      "cpu": 0,
      "memoryMiB": 0
    }
  },
  "grants": {
    "network": false,
    "gui": false
  },
  "systems": [
    "aarch64-linux",
    "x86_64-linux"
  ],
  "workerCapabilities": []
}
