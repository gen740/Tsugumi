{
  "tsugumiVersion": "0.9.4",
  "name": "信号の検出しきい値を比較",
  "nixPath": [
    {
      "name": "nixpkgs",
      "url": "github:NixOS/nixpkgs/nixos-unstable"
    },
    {
      "name": "tsugumi-kit",
      "url": "github:gen740/tsugumi-kit/main"
    }
  ],
  "trackedPaths": [],
  "agentExclude": [
    ".git",
    ".DS_Store"
  ],
  "recordLogs": true,
  "recordIO": false,
  "logLimitBytes": 134217728,
  "outputLimitBytes": 68719476736,
  "outputLimitEntries": 1000,
  "canvas": {
    "cards": [
      {
        "id": "start"
      },
      {
        "id": "samples"
      },
      {
        "id": "score"
      },
      {
        "id": "collect"
      },
      {
        "id": "summary"
      }
    ],
    "connections": [
      {
        "from": {
          "card": "start",
          "port": "out"
        },
        "to": {
          "card": "samples",
          "port": "start"
        }
      },
      {
        "from": {
          "card": "samples",
          "port": "out"
        },
        "to": {
          "card": "score",
          "port": "signal"
        }
      },
      {
        "from": {
          "card": "score",
          "port": "out"
        },
        "to": {
          "card": "collect",
          "port": "in"
        }
      },
      {
        "from": {
          "card": "collect",
          "port": "out"
        },
        "to": {
          "card": "summary",
          "port": "results"
        }
      }
    ]
  }
}
