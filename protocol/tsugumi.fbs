// Tsugumi external RPC. Generation 1.
//
// Root: Tsugumi.RPC.Message, file identifier "TSG1".
// WebSocket subprotocol: "tsugumi.rpc.v1" (one binary message = one FlatBuffer).
// Unix stream socket: 4 byte little-endian body length + FlatBuffer.
//
// Field ids and union tags are explicit. Before v1.0.0, protocol changes
// require matching clients and core. Defaults written as "= X" in comments are applied by the core
// when the field is absent; required scalars are optional scalars whose
// presence is validated. Every request may also be answered with Failure.

include "data.fbs";

include "rpc_trace.fbs";
namespace Tsugumi.RPC;
attribute "trace_secret";

// ---- Common ------------------------------------------------------------------

table Ack {}

table SourceInfo {
  path:string (id: 0, required);
  kind:Tsugumi.Data.SourceKind (id: 1);
  exists:bool = null (id: 2);
  hash:string (id: 3);
  size_bytes:uint64 = null (id: 4);
  /// The bytes of a file carried in snapshots and deltas: a nested project's
  /// documents and every canvas note (notes/<id>.md).
  document:[ubyte] (id: 5);
}

/// definitions/<id>/: _card.json (whose external field names a Card in
/// Card), and its optional README.md and _comments.json.
table Definition {
  id:string (id: 0, required);
  card_json:string (id: 1, required);
  readme:string (id: 2);
  comments_json:string (id: 3);
}

/// An authorized Nix input derived from the project wiring. The target path
/// is absolute in the project.
table CardNixReference {
  target:Tsugumi.Data.CardPath (id: 0, required);
  name:string (id: 1, required);
}

table CardParameter {
  name:string (id: 0, required);
  type:string (id: 1, required);
  value_json:string (id: 2, required);
}

table ResolvedCard {
  card:Tsugumi.Data.CardPath (id: 0, required);
  inputs:[Tsugumi.Data.Port] (id: 1, required);
  outputs:[Tsugumi.Data.Port] (id: 2, required);
  diagnostics:[Tsugumi.Data.Diagnostic] (id: 3, required);
  nix_references:[CardNixReference] (id: 4, required);
  parameters:[CardParameter] (id: 5);
}

/// state: idle -> queued -> preparing -> running -> succeeded|failed|cancelled,
/// cancelling while a cancel is in progress. Anything but idle carries run_id,
/// rev, execution_rev and accepted_at; terminal states carry ended_at.
table RunStatus {
  run_id:string (id: 0);
  state:Tsugumi.Data.RunState (id: 1);
  rev:uint64 = null (id: 2);
  execution_rev:uint64 = null (id: 3);
  accepted_at:int64 = null (id: 4);
  started_at:int64 = null (id: 5);
  ended_at:int64 = null (id: 6);
  failure:Tsugumi.Data.Failure (id: 7);
  /// The project's version (git commit) the run started from; absent when
  /// the project is not versioned.
  commit:string (id: 8);
  /// Debugging run that consumed saved inputs, rather than starting the Workflow.
  partial_run:bool (id: 9);
  /// Consumed values derived from a partial run, here or through saved inputs. Kept results retain this provenance.
  uses_partial_result:bool (id: 10);
  /// Cards of an active run that are in progress now, when the run's status is queried.
  active:[ActiveInvocation] (id: 11);
}

/// A Card invocation in progress: its current stage and the derivations its Nix build is building.
table ActiveInvocation {
  card:Tsugumi.Data.CardPath (id: 0, required);
  invocation:uint64 (id: 1);
  stage:Tsugumi.Data.Phase (id: 2);
  stage_elapsed_ms:uint64 (id: 3);
  /// Derivations being built now; the Card's own derivation is the last to build, after its dependencies.
  building:[BuildActivity] (id: 4);
}

table BuildActivity {
  derivation:string (id: 0, required);
  elapsed_ms:uint64 (id: 1);
}

enum ExecutionServiceKind:ubyte { local, remote_daemon }

table ExecutionResources {
  cpu_millis:uint32 = null (id: 0);
  memory_bytes:uint64 = null (id: 1);
}

enum IsolationGuarantee:ubyte { unavailable, partial, enforced }

table SandboxCapabilities {
  filesystem:IsolationGuarantee;
  pid:IsolationGuarantee;
  ipc:IsolationGuarantee;
  identity:IsolationGuarantee;
  network:IsolationGuarantee;
  gui:bool;
  host_paths:bool;
  requires_filesystem:bool;
  requires_pid:bool;
}

/// An execution service registered with this project's host.
table ExecutionService {
  /// Logical ID used by Card settings, independent of the host's name.
  id:string (id: 0, required);
  native_system:string (id: 1, required);
  /// Systems enabled for execution. Builds also depend on Nix configuration.
  systems:[string] (id: 2, required);
  kind:ExecutionServiceKind = local (id: 3);
  available:bool = true (id: 4);
  /// Whether the daemon can enforce requested CPU and memory caps.
  resource_limits:bool (id: 5);
  /// The daemon's concurrent job capacity across its projects, when known.
  max_jobs:uint32 = null (id: 6);
  sandbox:SandboxCapabilities (id: 7);
}

table ProjectSnapshot {
  project_id:string (id: 0, required);
  rev:uint64 = null (id: 1);
  execution_rev:uint64 = null (id: 2);
  project_json:string (id: 3, required);
  /// layout.bin (protocol/layout_document.fbs); empty when there is none.
  layout:[ubyte] (id: 4, required);
  definitions:[Definition] (id: 5, required);
  sources:[SourceInfo] (id: 6, required);
  resolution:[ResolvedCard] (id: 7, required);
  diagnostics:[Tsugumi.Data.Diagnostic] (id: 8, required);
  run:RunStatus (id: 9, required);
  /// Opaque client-owned JSON; the core never interprets camera or selection.
  view:[ubyte] (id: 10);
  view_id:string (id: 11);
  view_rev:uint64 = null (id: 12);
  execution_services:[ExecutionService] (id: 13);
}

/// Requirements of the accepted, resolved definitions, per executable Card.
/// Host policy and mount availability do not change this description.
table HostFolderRequirement {
  card:Tsugumi.Data.CardPath (id: 0, required);
  name:string (id: 1, required);
  write:bool (id: 2);
  /// The directory containing the declaring document, empty at the root.
  scope:string (id: 3, required);
}

table ProjectHostRequirements {
  rev:uint64 (id: 0);
  folders:[HostFolderRequirement] (id: 1);
}

/// -> ProjectHostRequirements. Reads the accepted document, never the disk.
table ProjectHostRequirementsRequest {}

// ---- Document changes --------------------------------------------------------

table SetProject { json:string (id: 0, required); }
/// A lock update or an explicit copy of a project's lock document.
/// Omitted JSON removes the document. Existing locks require base_hash.
table SetProjectLock {
  path:string (id: 0, required);
  json:string (id: 1);
  base_hash:string (id: 2);
}
/// The new layout.bin; empty removes it.
table SetLayout { layout:[ubyte] (id: 0, required); }
table PutDefinition {
  id:string (id: 0, required);
  card_json:string (id: 1, required);
  /// The new README.md; omitted removes it unless keep_readme. Empty keeps it.
  readme:string (id: 2);
  keep_readme:bool = false (id: 3);
  /// The new _comments.json; omitted removes it unless keep_comments. Empty
  /// keeps it.
  comments_json:string (id: 4);
  keep_comments:bool = false (id: 5);
}
table RemoveDefinition { id:string (id: 0, required); }
table PutSource {
  path:string (id: 0, required);
  bytes:[ubyte] (id: 1, required);
  base_hash:string (id: 2);  // required for existing files, omitted for new
}
table SourcePatch {
  offset:uint64 = null (id: 0);
  remove:uint64 = null (id: 1);
  text:string (id: 2, required);
}
table PatchSource {
  path:string (id: 0, required);
  base_hash:string (id: 1, required);
  patches:[SourcePatch] (id: 2, required);
}
table RemoveSource {
  path:string (id: 0, required);
  base_hash:string (id: 1, required);
}

union DocumentChangeValue {
  SetProject = 1,
  SetLayout = 2,
  PutDefinition = 3,
  RemoveDefinition = 4,
  PutSource = 5,
  PatchSource = 6,
  RemoveSource = 7,
  SetProjectLock = 8,
}

table DocumentChange { value:DocumentChangeValue (id: 1); }

table DocumentDelta {
  base_rev:uint64 = null (id: 0);
  rev:uint64 = null (id: 1);
  execution_rev:uint64 = null (id: 2);
  op_id:string (id: 3, required);
  origin:string (id: 4, required);
  project_json:string (id: 5);
  /// The new layout.bin when layout_changed; empty when it was removed.
  layout:[ubyte] (id: 6);
  definitions_upsert:[Definition] (id: 7, required);
  definitions_removed:[string] (id: 8, required);
  sources_upsert:[SourceInfo] (id: 9, required);
  sources_removed:[string] (id: 10, required);
  resolution:[ResolvedCard] (id: 11, required);
  diagnostics:[Tsugumi.Data.Diagnostic] (id: 12, required);
  layout_changed:bool (id: 13);
}

table SaveResult {
  delta:DocumentDelta (id: 0);  // omitted when nothing effectively changed
  rev:uint64 = null (id: 1);
  execution_rev:uint64 = null (id: 2);
  replayed:bool = null (id: 3);
  /// Opaque metadata supplied by the host for this accepted save.
  operation_data:[ubyte] (id: 4);
}

table ProjectCacheClearResult {
  deleted:[string] (id: 0, required);
  retained:[string] (id: 1, required);
  freed_bytes:uint64 = null (id: 2);
}

table RunHistoryDeleteResult {
  deleted_runs:uint64 = null (id: 0);
  freed_bytes:uint64 = null (id: 1);
}

/// A regular file in the realized output.
table NixOutputFile {
  /// Relative to the output directory, with / between folders.
  path:string (id: 0, required);
  content:[ubyte] (id: 1);
}

table EvaluateNixResult {
  rev:uint64 = null (id: 0);
  /// Strict JSON (up to 8 MiB). A derivation is represented by its output path.
  json:string (id: 1);
  /// Regular output files, up to 2000 entries and 8 MiB including paths.
  files:[NixOutputFile] (id: 2);
  truncated:bool = false (id: 3);
  failure:Tsugumi.Data.Failure (id: 4);
  /// The last 256 KiB of the build log on failure.
  log:string (id: 5);
}

table RunAccepted {
  op_id:string (id: 0, required);
  run:RunStatus (id: 1, required);
  replayed:bool = null (id: 2);
}

union ReceiptValue {
  SaveResult = 1,
  RunAccepted = 3,
  ProjectCacheClearResult = 4,
  Failure: Tsugumi.Data.Failure = 6,
  RunHistoryDeleteResult = 7,
  VersionResult = 8,
  ProjectShellResult = 9,
  RunScratchDeleteResult = 10,
  RunCategoryDeleteResult = 11,
}

table OperationReceipt {
  op_id:string (id: 0, required);
  result:ReceiptValue (id: 2);
}

// ---- Requests ----------------------------------------------------------------

/// -> HelloResult. token is required on WebSocket. Project mismatch is
/// permission_denied. Must be the first request, within 5 s of connecting.
table SessionHelloRequest {
  expected_project_id:string (id: 0);
  token:string (id: 1, trace_secret);
  client:Tsugumi.Trace.Client (id: 2);
}

/// -> OpenResult. Creates (or replaces) the connection's subscription.
table ProjectOpenRequest { view_id:string (id: 0); }

/// -> ProjectSnapshot. Read current documents, definitions, sources and revision.
table ProjectInspectRequest {}

/// -> CardIdResult. Reserve a permanent unique Card id from stem; repeated calls reserve fresh ids.
table CardIdRequest {
  stem:string (id: 0, required);
  /// Project-relative directory: empty for the root, or externals/<id>/,
  /// repeated for nesting. May name a project being created in the same draft.
  project_path:string (id: 1);
}
table CardIdResult {
  id:string (id: 0, required);
}

// Core streams a local file into a private durable file, hashes it and applies
// it through the normal save. The host chooses roots and authorizes access.
table SourceTransfer {
  path:string (required);
  from:string (required);
  base_hash:string;
  /// Absent means the project root. Otherwise an absolute host-selected root.
  source_root:string;
  /// Confirmed source hash, when copying from another Card.
  expected_hash:string;
}

/// -> SaveResult. Apply document changes atomically at base_rev.
table ProjectSaveRequest {
  base_rev:uint64 = null (id: 0);
  op_id:string (id: 1, required);
  origin:string (id: 2, required);
  changes:[DocumentChange] (id: 3);
  /// Permission widenings explicitly approved by the caller, as named by
  /// approval_required.
  approved_permissions:[string] (id: 4);
  /// Compare the proposed permissions with the accepted document and reject
  /// every widening absent from approved_permissions, regardless of origin.
  check_permissions:bool (id: 5);
  /// Local file references; source bytes never travel through the RPC frame.
  transfers:[SourceTransfer] (id: 6);
  /// Opaque host intent for the existing op_id digest, before concrete expansion.
  /// A caller can explicitly retry a revision conflict with the same intent and id.
  save_intent:string (id: 7);
  /// Carried unchanged in SaveResult, including a replay of this operation id.
  /// The project core does not interpret host editing metadata.
  operation_data:[ubyte] (id: 8);
}

/// -> SaveResult. Import external edits into the accepted document at base_rev.
table ProjectReloadRequest {
  base_rev:uint64 = null (id: 0);
  op_id:string (id: 1, required);
  origin:string (id: 2, required);
  /// Permission widenings explicitly approved by the caller, as named by
  /// approval_required.
  approved_permissions:[string] (id: 3);
  /// Reject widenings absent from approved_permissions when true.
  check_permissions:bool (id: 4);
}

/// -> ProjectValidateResult. targets = [] means everything; mode = executable.
table ProjectValidateRequest {
  /// Omitted: the latest revision.
  at_rev:uint64 = null (id: 0);
  targets:[Tsugumi.Data.CardPath] (id: 1);
  mode:Tsugumi.Data.ValidateMode (id: 2);
  /// Proposed changes (as in project_save): the document as it would be after
  /// them is checked and nothing is saved. For the apps' editors; the model is
  /// not offered this field (it saves, then checks).
  changes:[DocumentChange] (id: 3);
}

/// -> ProjectCacheClearResult. Clear this project's build cache.
table ProjectCacheClearRequest { op_id:string (id: 0, required); }

/// -> RunScratchDeleteResult. Delete paths selected from the scratch usage report.
table RunScratchDeleteRequest {
  op_id:string (id: 0, required);
  paths:[string] (id: 1, required);
}
table RunScratchDeleteResult {
  deleted:[string] (id: 0, required);
  retained:[string] (id: 1, required);
  /// Sum of successfully measured deleted folders; unknown sizes are excluded.
  freed_bytes:uint64 (id: 2);
}
table RunScratchUsage {
  /// Relative scratch folder: runs/<project run number> or recovery.
  path:string (id: 0, required);
  /// Measured bytes; use only when size_unknown is false.
  bytes:uint64 (id: 1);
  /// Measurement failed. The folder remains available for explicit deletion.
  size_unknown:bool (id: 2);
}

/// -> ProjectCacheUsageResult. Measure build and scratch usage.
table ProjectCacheUsageRequest {}

table ProjectCacheUsage {
  project:string (id: 0, required);
  name:string (id: 1, required);
  /// NAR bytes of the rooted closure, including build dependencies. Shared paths
  /// count once in each project, and only once in the total.
  build_bytes:uint64 = null (id: 2);
  scratch_bytes:uint64 = null (id: 3);
  /// Latest project start or root use; absent when there are no roots.
  last_used:int64 = null (id: 4);
  error:string (id: 5);
  run_scratch:[RunScratchUsage] (id: 6);
}

table ProjectCacheUsageResult {
  projects:[ProjectCacheUsage] (id: 0, required);
  build_bytes:uint64 = null (id: 1);
  store_capacity_bytes:uint64 = null (id: 2);
  store_available_bytes:uint64 = null (id: 3);
  measured_at:int64 = null (id: 4);
  current_project:string (id: 5);
  error:string (id: 6);
  /// This project's latest run remains usable; its scratch cannot be deleted here.
  protected_run:string (id: 7);
}

/// -> NixPathLockedSource. Fetch a source for an explicit Host lock update.
table NixPathLockSourceRequest { url:string (id: 0, required); }

/// -> RewrittenParamLiteral. Prepare a guarded params.nix edit for the Host.
table RewriteParamLiteralRequest {
  card:Tsugumi.Data.CardPath (id: 0, required);
  name:string (id: 1, required);
  literal:string (id: 2, required);
  at_rev:uint64 = null (id: 3);
}
enum RunRecordCategory:ubyte { Unspecified, Logs, Values, Artifacts }

/// -> RunCategoryDeleteResult. Delete one category from a finished run.
table RunCategoryDeleteRequest {
  op_id:string (id: 0, required);
  run_id:string (id: 1, required);
  category:RunRecordCategory (id: 2);
}


table RunCategoryDeleteResult {
  run_id:string (id: 0, required);
  category:RunRecordCategory (id: 1);
}

/// -> RunHistoryDeleteResult. Delete finished runs and their records, values, logs and files. ended_before is a Unix-millisecond cutoff; omitted means all finished runs.
table RunHistoryDeleteRequest {
  op_id:string (id: 0, required);
  ended_before:int64 = null (id: 1);
  run_ids:[string] (id: 2);
  restrict_to_run_ids:bool = false (id: 3);
}

/// -> VersionResult. Initialize git version history with the saved project.
table VersionInitRequest {
  op_id:string (id: 0, required);
  origin:string (id: 1, required);
}

/// -> VersionResult. Commit saved changes and tag the version with name and message.
table VersionMarkRequest {
  op_id:string (id: 0, required);
  origin:string (id: 1, required);
  name:string (id: 2, required);
  message:string (id: 3);
}

/// -> SaveResult. Commit current changes and restore the project from commit.
table VersionCheckoutRequest {
  base_rev:uint64 = null (id: 0);
  op_id:string (id: 1, required);
  origin:string (id: 2, required);
  commit:string (id: 3, required);
}

/// -> VersionGraph, newest first.
table VersionGraphRequest {
  limit:uint32 = null (id: 0);
  /// Include the comment changes of each commit relative to its first parent.
  include_comments:bool (id: 1);
}

/// -> VersionCanvas. Read a version's layout, definition kinds and connections.
table VersionCanvasRequest { commit:string (id: 0, required); }

/// -> VersionNote. Neutral facts, cached in refs/notes/tsugumi-record.
table VersionNoteRequest {
  commit:string (id: 0, required);
}

/// -> VersionDiff. Read a bounded patch of workflow, definitions and code.
table VersionDiffRequest {
  commit:string (id: 0, required);
  /// Compare with this commit when present, or with the first parent.
  from_commit:string (id: 1);
}

/// -> VersionComments. Read a version’s comment changes from its first parent.
table VersionCommentsRequest { commit:string (id: 0, required); }

/// -> OperationResult.
table OperationGetRequest { op_id:string (id: 0, required); save_intent:string (id: 1); }

/// -> SourcePage. depth = 0 (0..8), include_directories = false, limit = 100.
table ProjectFileListRequest {
  /// Relative to the project; "" or "." is the project folder.
  path:string (id: 0, required);
  /// Omitted: the latest revision.
  at_rev:uint64 = null (id: 1);
  depth:uint32 = null (id: 2);
  include_directories:bool = null (id: 3);
  cursor:string (id: 4);
  limit:uint32 = null (id: 5);
}

/// -> SourceInfo.
table ProjectFileStatRequest {
  path:string (id: 0, required);
  at_rev:uint64 = null (id: 1);
}

/// -> FileContent. Read a file page; offset defaults to 0, limit_bytes to 262144 (max 1 MiB).
table ProjectFileReadRequest {
  path:string (id: 0, required);
  /// Omitted: the latest revision.
  at_rev:uint64 = null (id: 1);
  if_hash:string (id: 2);
  offset:uint64 = null (id: 3);
  limit_bytes:uint32 = null (id: 4);
}

/// -> InputTypesResult. Read resolved incoming sources and full types. output_port selects an upstream output instead.
table InputTypesRequest {
  card:Tsugumi.Data.CardPath (id: 0, required);
  output_port:string (id: 1);
  at_rev:uint64 = null (id: 2);
}

table InputType {
  port:string (id: 0, required);
  source_card:Tsugumi.Data.CardPath (id: 1);
  source_port:string (id: 2);
  type:Tsugumi.Data.Port (id: 3);
}

table InputTypesResult {
  rev:uint64 = null (id: 0);
  inputs:[InputType] (id: 1);
}

/// -> OutputTypesResult. Compile _outputs.fbs text to reflection schema; port and type_name optionally set an output's type in returned text.
table OutputTypesRequest {
  text:string (id: 0, required);
  port:string (id: 1);
  type_name:string (id: 2);
}

/// -> EvaluateNixResult. Evaluate a Nix expression on the local system in the saved Card's directory with its nixPath, params and inputs. Returns JSON. For Build SDK, evaluate (import ./. { inherit params inputs; }).api with build enabled to return the derivation's output files.
table EvaluateNixRequest {
  /// Card path segments from the root project.
  card:Tsugumi.Data.CardPath (id: 0, required);
  at_rev:uint64 = null (id: 1);
  /// Nix expression relative to this Card's definition directory.
  expression:string (id: 2, required);
  /// Realize the derivation returned by the expression. Defaults to false.
  build:bool = false (id: 3);
}

/// -> RunPlanResult. Preview the Cards a run reaches; propagate defaults to true.
table RunPlanRequest {
  at_rev:uint64 = null (id: 0);
  card:Tsugumi.Data.CardPath (id: 1, required);
  propagate:bool = null (id: 2);
}

/// -> RunAccepted. Start a run at base_rev. If a required host path is unbound, ask the user to choose a folder in Project Settings > Host Paths. propagate defaults to true, max_concurrency to 4 (1..64). Omitted nix_jobs and nix_cores use the environment defaults for local builds.
table RunRequest {
  base_rev:uint64 = null (id: 0);
  op_id:string (id: 1, required);
  origin:string (id: 2, required);
  card:Tsugumi.Data.CardPath (id: 3, required);
  propagate:bool = null (id: 4);
  max_concurrency:uint32 = null (id: 5);
  nix_jobs:uint32 = null (id: 6);
  nix_cores:uint32 = null (id: 7);
  /// Typed starting values for a packed debug run.
  inputs:[PackedRunInput] (id: 8);
}

table PackedRunInput {
  name:string (id: 0, required);
  schema:string (id: 1, required);
  bytes:[ubyte] (id: 2, required);
}

/// -> RunStatus. Cancel run_id.
table RunCancelRequest { run_id:string (id: 0, required); }

/// -> RunStatus. Read run_id; omitted selects the active run, then the latest locally started run, then idle. An active run lists its Cards in progress with their stage and derivations being built.
table RunStatusRequest { run_id:string (id: 0); }

table ShellMount { path:string (required); name:string (required); project_relative:bool; writable:bool; }

/// -> ProjectShellResult. Run a command in a staged Card source workspace; successful source edits save atomically. Attached folders are at attached/<SHA-256(path)[0:16]>; scratch/ persists. timeout_ms defaults to 10000 (1..30000). Returns exit status, bounded stdout/stderr and full-output paths.
table ProjectShellRequest {
  op_id:string (id: 0, required);
  command:string (id: 1, required);
  timeout_ms:uint32 = null (id: 2);
  /// Make the filesystem read-only except private diagnostic scratch.
  read_only:bool (id: 3);
  /// Hide the control directory, home credentials and shared temporary files.
  hide_credentials:bool (id: 4);
  /// Block Unix socket connections (except macOS name resolution). On macOS,
  /// also block local IP endpoints, session Mach services and outside signals.
  no_project_socket:bool (id: 5);
  /// Explicit workspace relative to the project root; absent uses the project.
  working_directory:string (id: 6);
  /// Writable subtrees relative to working_directory, with a read-only root.
  writable_paths:[string] (id: 7);
  /// Read-only mounts at attached/<name>; native paths or VM chat shares.
  mounts:[ShellMount] (id: 8);
  /// Persist full stdout/stderr below this project-relative prefix.
  output_prefix:string (id: 9);
  /// Hide the original project while exposing only the workspace.
  workspace_only:bool (id: 10);
  /// Read-only files inside writable subtrees (including reserved placeholders).
  protected_paths:[string] (id: 11);
  /// Host-selected absolute paths denied in this shell view, including mounts.
  excluded_paths:[string] (id: 12);
}

table ProjectShellResult {
  stdout_bytes:[ubyte] (id: 0, required);
  stderr_bytes:[ubyte] (id: 1, required);
  exit_code:int32 = -1 (id: 2);
  signal:int32 (id: 3);
  cancelled:bool (id: 4);
  timed_out:bool (id: 5);
  stdout_truncated:bool (id: 6);
  stderr_truncated:bool (id: 7);
  stdout_size:uint64 (id: 8);
  stderr_size:uint64 (id: 9);
  output_prefix:string (id: 10);
}

/// -> RunPage, newest accepted first.
table RunHistoryRequest {
  card:Tsugumi.Data.CardPath (id: 0);
  artifacts_only:bool = null (id: 1);
  cursor:string (id: 2);
  limit:uint32 = null (id: 3);
}

/// -> InvocationPage, ascending invocation number.
table RunInvocationsRequest {
  run_id:string (id: 0, required);
  card:Tsugumi.Data.CardPath (id: 1, required);
  cursor:string (id: 2);
  limit:uint32 = null (id: 3);
}

/// -> InvocationPage. Read each Card's latest invocation in a run.
table RunLatestInvocationsRequest { run_id:string (id: 0, required); }

/// -> RunDefinitionPaths. Accepted definition files for the recorded Card
/// and its enclosing Cards, or for the whole run if card is absent.
table RunDefinitionPathsRequest {
  run_id:string (required);
  card:Tsugumi.Data.CardPath;
}
table RunDefinitionPaths { paths:[string] (required); }

/// -> BuildEnvironmentPage. Read recorded environments in first-use order; no evaluation.
table RunEnvironmentsRequest {
  run_id:string (id: 0, required);
  offset:uint64 = null (id: 1);
  limit:uint32 = null (id: 2);
}

/// -> EnvironmentPathPage. Read a recorded runtime closure in store-path order, including its manifest.
table RunEnvironmentPathsRequest {
  run_id:string (id: 0, required);
  environment_id:string (id: 1, required);
  offset:uint64 = null (id: 2);
  limit:uint32 = null (id: 3);
  /// Case-insensitive substring filter; offset and total count matches.
  query:string (id: 4);
  /// Together with excluding_environment_id, exclude paths in that recorded environment.
  excluding_run_id:string (id: 5);
  excluding_environment_id:string (id: 6);
}

/// -> EnvironmentUsePage. Recorded users of a shared environment, ordered by Card and invocation.
table RunEnvironmentUsesRequest {
  run_id:string (id: 0, required);
  environment_id:string (id: 1, required);
  offset:uint64 = null (id: 2);
  limit:uint32 = null (id: 3);
}
table EnvironmentUse {
  card:string (id: 0, required);
  invocation:uint64 (id: 1);
}
table EnvironmentUsePage {
  uses:[EnvironmentUse] (id: 0, required);
  next_offset:uint64 = null (id: 1);
}

table BuildEnvironment {
  id:string (id: 0, required);
  derivation:string (id: 1, required);
  manifest:string (id: 2, required);
  system:string (id: 3, required);
  path_count:uint64 (id: 4);
}

table BuildEnvironmentPage {
  environments:[BuildEnvironment] (id: 0, required);
  next_offset:uint64 = null (id: 1);
  /// The binary caches (URLs, without credentials) configured for the run's
  /// builds, on every page. A store path may have been downloaded from any of
  /// them or built locally: which, is not recorded. Empty for a run recorded
  /// without this list.
  substituters:[string] (id: 2);
}

table EnvironmentPathPage {
  paths:[string] (id: 0, required);
  total:uint64 (id: 1);
  next_offset:uint64 = null (id: 2);
}

/// -> RecordResult. Read a Card's invocation record; choose invocation or follow_latest=true.
table RunRecordRequest {
  run_id:string (id: 0, required);
  card:Tsugumi.Data.CardPath (id: 1, required);
  invocation:uint64 = null (id: 2);
  follow_latest:bool = null (id: 3);
}

/// -> FileContent. Read a recorded port value page; offset defaults to 0.
table RunValueReadRequest {
  run_id:string (id: 0, required);
  card:Tsugumi.Data.CardPath (id: 1, required);
  invocation:uint64 = null (id: 2);
  side:Tsugumi.Data.ValueSide (id: 3);
  port:string (id: 4, required);
  offset:uint64 = null (id: 5);
  limit_bytes:uint32 = null (id: 6);
}

/// -> ArtifactPage. List a run's artifacts (invocation requires card), or
/// look up artifact_ids: unknown ids are left out.
table ArtifactListRequest {
  run_id:string (id: 0);
  card:Tsugumi.Data.CardPath (id: 1);
  invocation:uint64 = null (id: 2);
  cursor:string (id: 3);
  limit:uint32 = null (id: 4);
  /// uuid text; without run_id.
  artifact_ids:[string] (id: 5);
}

/// -> FileContent. Read a member of a sealed artifact by its UUID.
table ArtifactReadRequest {
  artifact_id:string (id: 0, required);
  member:string (id: 1);
  offset:uint64 = null (id: 2);
  limit_bytes:uint32 = null (id: 3);
}

/// -> LogSlice. Read recorded run logs. Select the Card and stream=build for Nix evaluation and build output from its execution target, including failed builds and a build in progress (tail=true for its latest lines). Use run_record for the failure diagnostic. invocation requires card. tail=true reads the end with offset=0.
table LogRangeRequest {
  run_id:string (id: 0, required);
  card:Tsugumi.Data.CardPath (id: 1);
  invocation:uint64 = null (id: 2);
  stream:Tsugumi.Data.LogStream (id: 3);
  offset:uint64 = null (id: 4);
  tail:bool = null (id: 5);
  /// Maximum number of bytes to read.
  limit_bytes:uint32 = null (id: 6);
  /// Read up to limit_bytes immediately before this exclusive byte offset.
  /// Cannot be combined with tail or a nonzero offset.
  before:uint64 = null (id: 7);
  /// Read the terminal display. Offsets and the size use four units per Unicode scalar.
  terminal:bool = false (id: 8);
  /// Raw byte size of the previous terminal update. Read the tail if a redraw overwrote cells since then.
  terminal_since:uint64 = null (id: 9);
  /// Read stdout or stderr from the active run's transient log.
  live:bool = false (id: 10);
}

/// -> Ack. Close a view owned by this subscription. Each live route receives
/// one close event. Repeating a completed close has no effect.
table ViewCloseRequest {
  session:string (required);
}

/// -> Ack. Send opaque bytes to live processes of a Card registered on this
/// window. The address is a project-root Card path or "*" for all registered
/// Cards. An address without a live recipient returns an error.
table ViewSendRequest {
  session:string (required);
  to:string (required);
  bytes:[ubyte] (required);
}

/// -> Ack. Return display capacity after the UI forwards or discards a message.
table ViewCreditRequest {
  subscription_id:string (required);
  session:string (required);
  bytes:uint32;
  credit_id:uint64 = null;
}

// A client's viewport, carried by the core as one FlatBuffer.
table ViewCamera {
  scope:[string];
  x:double;
  y:double;
  zoom:double;
}
table ClientView {
  scope:[string];
  cameras:[ViewCamera];
  selected_cards:[Tsugumi.Data.CardPath];
}

/// -> ViewSaveResult. CAS on view_rev only.
table ViewSaveRequest {
  view_id:string (id: 0, required);
  base_view_rev:uint64 = null (id: 1);
  view:[ubyte] (id: 2, required);
}

/// -> FileContent. Read a page of the immutable view file pinned by the open
/// session. Only its presenting subscription may read it. FileContent.name is
/// the declared view name and hash is the Nix store path. offset defaults to 0
/// and limit_bytes defaults to 1 MiB (1..1048576). This RPC is transient.
table CardViewReadRequest {
  session:string (required);
  offset:uint64 = null;
  limit_bytes:uint32 = null;
}

/// -> ProjectActivity. Observe active runs and queued/running requests, across
/// all connections. Does not stop work or restrict connections.
table ProjectActivityRequest {}
table ProjectActivity { busy:bool; }

union RequestPayload {
  SessionHelloRequest = 1,
  ProjectOpenRequest = 2,
  ProjectInspectRequest = 4,
  ProjectSaveRequest = 5,
  ProjectReloadRequest = 6,
  ProjectValidateRequest = 7,
  ProjectCacheClearRequest = 9,
  OperationGetRequest = 10,
  ProjectFileListRequest = 11,
  ProjectFileStatRequest = 12,
  ProjectFileReadRequest = 13,
  EvaluateNixRequest = 15,
  RunPlanRequest = 17,
  RunRequest = 18,
  RunCancelRequest = 19,
  RunStatusRequest = 20,
  RunHistoryRequest = 21,
  RunInvocationsRequest = 22,
  RunRecordRequest = 23,
  RunValueReadRequest = 24,
  ArtifactListRequest = 25,
  ArtifactReadRequest = 26,
  LogRangeRequest = 27,
  ViewCloseRequest = 28,
  ViewSaveRequest = 29,
  RunHistoryDeleteRequest = 30,
  OutputTypesRequest = 31,
  VersionInitRequest = 33,
  VersionMarkRequest = 34,
  VersionCheckoutRequest = 35,
  VersionGraphRequest = 36,
  VersionCanvasRequest = 37,
  NixPathLockSourceRequest = 40,
  RewriteParamLiteralRequest = 66,
  RunLatestInvocationsRequest = 41,
  RunEnvironmentsRequest = 42,
  RunEnvironmentPathsRequest = 43,
  ProjectShellRequest = 44,
  ProjectCacheUsageRequest = 48,
  RunScratchDeleteRequest = 49,
  CardIdRequest = 50,
  VersionNoteRequest = 51,
  RunEnvironmentUsesRequest = 52,
  ProjectHostRequirementsRequest = 53,
  InputTypesRequest = 54,
  ProjectActivityRequest = 55,
  CoreTraceRequest:Tsugumi.Trace.CoreTraceRequest = 56,
  RunDefinitionPathsRequest = 57,
  VersionDiffRequest = 58,
  VersionCommentsRequest = 59,
  RunCategoryDeleteRequest = 60,
  CardViewReadRequest = 62,
  ViewSendRequest = 63,
  ViewCreditRequest = 64,
}

// ---- Replies -----------------------------------------------------------------

table VersionResult {
  commit:string (id: 0, required);
  branch:string (id: 1);
}

/// A run's result as its commit's note records it (refs/notes/tsugumi).
/// Mechanical version facts; persisted records are private to the project daemon.
table VersionCommitFacts { kind:string (required); card:string (required); }
table VersionInvocationCount { card:string (required); count:ulong; }
table VersionRunFailure { card:string (required); kind:string (required); }
table VersionRunFacts {
  whole:bool;
  card:string (required);
  propagate:bool;
  saved_inputs:bool;
  ran:[VersionInvocationCount] (required);
  failures:[VersionRunFailure] (required);
  never:[string] (required);
}
table VersionCardChange { card:string (required); kinds:[string] (required); }
table VersionChanges {
  added:[string] (required);
  removed:[string] (required);
  changed:[VersionCardChange] (required);
  workflow:bool;
}

table VersionRun {
  run_id:string (id: 0, required);
  state:string (id: 1, required);
  ended:string (id: 2);
  seconds:double (id: 3);
  /// Localized by the Host from facts; absent on the project endpoint.
  summary:string (id: 4);
  facts:VersionRunFacts (id: 5);
}

table VersionCommit {
  id:string (id: 0, required);
  parents:[string] (id: 1);
  summary:string (id: 2);
  /// User text is opaque. The Host supplies automatic text from facts.
  message:string (id: 3);
  author:string (id: 4);
  time:int64 = null (id: 5);
  branches:[string] (id: 6);
  tags:[string] (id: 7);
  runs:[VersionRun] (id: 8);
  /// Card keys whose files changed from the first parent ("" for the
  /// project's own documents).
  changed:[string] (id: 9);
  facts:VersionCommitFacts (id: 10);
  comments:[VersionComment] (id: 11);
}

// Raw version definition data. Presentation is interpreted by the host.
table VersionCanvasCard {
  id:string (id: 0, required);
  /// The _card.json "type" in that version; empty when it cannot be read.
  kind:string (id: 1, required);
  fan:uint32 (id: 2);
}
table VersionCanvasWire {
  from:string (id: 0, required);
  to:string (id: 1, required);
}
table VersionCanvas {
  cards:[VersionCanvasCard] (id: 0, required);
  wires:[VersionCanvasWire] (id: 1, required);
  /// That version's layout.bin; empty when it had none.
  layout:[ubyte] (id: 2, required);
}

table VersionNote {
  changes:VersionChanges (id: 0, required);
  commit:string (id: 1, required);
}

/// A comment on a Card that a version or a save changed.
table VersionComment {
  card:string (id: 0, required);
  text:string (id: 1, required);
  /// added, edited, resolved, reopened or removed. A comment written and
  /// resolved within one version is resolved.
  change:string (id: 2, required);
  resolution:string (id: 3);
  /// Who did it, as the comment records it: agent or user. Absent when it is
  /// not recorded, as for a comment that is gone.
  by:string (id: 4);
  /// The Cards the save that resolved it changed.
  cards:[string] (id: 5);
}

table VersionDiff { text:string (required); truncated:bool; }
table VersionComments { comments:[VersionComment] (required); }

table VersionGraph {
  enabled:bool (id: 0);
  head:string (id: 1);
  branch:string (id: 2);
  /// Saved changes not committed yet.
  dirty:bool (id: 3);
  commits:[VersionCommit] (id: 4);
}

table HelloResult {
  project_id:string (id: 0, required);
  server_instance_id:string (id: 1, required);
  capabilities:[string] (id: 2, required);
}

table OpenResult {
  snapshot:ProjectSnapshot (id: 0, required);
  subscription_id:string (id: 1, required);
  seq:uint64 = null (id: 2);
}

table ProjectValidateResult {
  rev:uint64 = null (id: 0);
  valid:bool = null (id: 1);
  diagnostics:[Tsugumi.Data.Diagnostic] (id: 2, required);
}

table OperationResult {
  state:Tsugumi.Data.OperationState (id: 0);
  receipt:OperationReceipt (id: 1);
}

table SourcePage {
  rev:uint64 = null (id: 0);
  entries:[SourceInfo] (id: 1, required);
  next_cursor:string (id: 2);
}

table FileContent {
  name:string (id: 0, required);
  hash:string (id: 1, required);
  size_bytes:uint64 = null (id: 2);
  offset:uint64 = null (id: 3);
  next_offset:uint64 = null (id: 4);
  bytes:[ubyte] (id: 5, required);
  eof:bool = null (id: 6);
}

table NixPathLockedSource {
  rev:string (id: 0);
  narHash:string (id: 1, required);
}

table RewrittenParamLiteral {
  path:string (id: 0, required);
  base_hash:string (id: 1, required);
  text:string (id: 2, required);
}

table OutputTypesResult {
  bfbs:[ubyte] (id: 0, required);  // empty when the text does not compile
  root_type:string (id: 1);        // the catalog (fully qualified)
  text:string (id: 2);             // with the port changed
  error:string (id: 3);
}

table RunPlanResult {
  rev:uint64 = null (id: 0);
  targets:[Tsugumi.Data.CardPath] (id: 1, required);
  starts:[Tsugumi.Data.CardPath] (id: 2, required);
  build_candidates:[Tsugumi.Data.CardPath] (id: 3, required);
  diagnostics:[Tsugumi.Data.Diagnostic] (id: 4, required);
}

table RunSummary {
  status:RunStatus (id: 0, required);
  source_hash:string (id: 1, required);
  target:Tsugumi.Data.CardPath (id: 2, required);
  propagate:bool = null (id: 3);
}

table RunPage {
  runs:[RunSummary] (id: 0, required);
  next_cursor:string (id: 1);
}

table UpstreamPort {
  card:Tsugumi.Data.CardPath (id: 0, required);
  port:string (id: 1, required);
}

table WaitingInput {
  port:string (id: 0, required);
  upstream:[UpstreamPort] (id: 1, required);
}

table InvocationSummary {
  run_id:string (id: 0, required);
  card:Tsugumi.Data.CardPath (id: 1, required);
  invocation:uint64 = null (id: 2);
  state:Tsugumi.Data.CardState (id: 3);
  phase:Tsugumi.Data.Phase (id: 4);  // unspecified means omitted
  started_at:int64 = null (id: 5);
  ended_at:int64 = null (id: 6);
  duration_ms:uint64 = null (id: 7);
  failure:Tsugumi.Data.Failure (id: 8);
  waiting_inputs:[WaitingInput] (id: 9, required);
  /// true when the build was reused from the cache (no evaluate/build work).
  build_cached:bool = null (id: 10);
  /// Stages this invocation went through, in order, with their times (core
  /// clock, ms since 1970). Stages that do not apply are absent.
  stages:[StageTime] (id: 11);
  /// true when the call ran in a worker kept from an earlier invocation.
  worker_reused:bool = null (id: 12);
  /// Output ports that carried a value downstream (empty while running).
  outputs_sent:[string] (id: 13);
  /// When the inputs were all there; started_at - ready_at is the wait for
  /// a free lane (parallel limit, serial Card).
  ready_at:int64 = null (id: 14);
  /// The program the kernel ran the Card's binaries with (binfmt_misc), for a
  /// Card built for another system (its `system` setting); absent when it ran
  /// natively.
  emulator:string (id: 15);
  /// Recorded Nix environment, queryable through RunEnvironmentsRequest.
  environment_id:string (id: 16);
  /// Logical service that started this Card's execution, if any.
  execution_service:string (id: 17);
  execution_job_id:string (id: 18);
  execution_system:string (id: 19);
  execution_resources:ExecutionResources (id: 20);
  execution_state:Tsugumi.Data.RemoteExecutionState (id: 21);
  batch_activation:uint64 = null (id: 22);
  batch_index:uint32 = null (id: 23);
  batch_size:uint32 = null (id: 24);
  implementation_index:uint32 = null (id: 25);
  transfer_name:string (id: 26);
  transfer_direction:string (id: 27);
  transfer_done:uint64 (id: 28);
  transfer_total:uint64 (id: 29);
  /// The invocation omitted log output at this combined limit, in bytes.
  log_truncated_at_bytes:uint64 = null (id: 30);
  /// Human-readable name of the implementation: a `label` of a Nix run list
  /// entry.
  /// Absent when the implementation has no label; implementation_index still
  /// identifies it.
  implementation_label:string (id: 31);
  /// Names of the Card secrets handed to this invocation's process (never
  /// their values), in the order the Card declares them.
  secrets:[string] (id: 32);
}

table StageTime {
  phase:Tsugumi.Data.Phase (id: 0);
  outcome:Tsugumi.Data.StageOutcome (id: 1);
  start:int64 = null (id: 2);
  end:int64 = null (id: 3);
}

table RunBatchOutput {
  port:string (id: 0, required);
  count:uint32 (id: 1);
  execution_list:bool (id: 2);
}

table RunBatch {
  card:Tsugumi.Data.CardPath (id: 0, required);
  activation:uint64 (id: 1);
  invocation_count:uint32 (id: 2);
  execution_list:bool (id: 3);
  complete:bool (id: 4);
  failed:bool (id: 5);
  outputs:[RunBatchOutput] (id: 6, required);
}

table InvocationPage {
  records:[InvocationSummary] (id: 0, required);
  next_cursor:string (id: 1);
  batches:[RunBatch] (id: 2);
}

table InputSource {
  port:string (id: 0, required);
  card:Tsugumi.Data.CardPath (id: 1, required);
  invocation:uint64 = null (id: 2);
}

table InvocationRecord {
  summary:InvocationSummary (id: 0, required);
  inputs:[Tsugumi.Data.NamedValue] (id: 1, required);
  outputs:[Tsugumi.Data.NamedValue] (id: 2, required);
  input_sources:[InputSource] (id: 3, required);
  record_io:bool = null (id: 4);
  /// Parameters captured from the run's immutable document; absent if unavailable.
  params:Tsugumi.Data.InvocationParams (id: 5);
  /// Worker selection measurements retained independently of recording settings.
  worker_probes:[Tsugumi.Data.WorkerProbeResult] (id: 6);
}

table HistoryState {
  state:Tsugumi.Data.CardState (id: 0);
  failure:Tsugumi.Data.Failure (id: 1);
  time:int64 = null (id: 2);
}

table Aggregate {
  calls:uint64 = null (id: 0);
  succeeded:uint64 = null (id: 1);
  failed:uint64 = null (id: 2);
  cancelled:uint64 = null (id: 3);
  total_duration_ms:uint64 = null (id: 4);
}

table RecordResult {
  selected_invocation:uint64 = null (id: 0);
  record:InvocationRecord (id: 1);
  run:RunSummary (id: 2, required);
  status:HistoryState (id: 3, required);
  aggregate:Aggregate (id: 4, required);
  exists:bool = null (id: 5);
  recording_disabled:bool = null (id: 6);
  truncated:bool = null (id: 7);
  orphaned:bool = null (id: 8);
}

table ArtifactMember {
  path:string (id: 0, required);
  size_bytes:uint64 = null (id: 1);
  hash:string (id: 2, required);
}

/// Where a sealed artifact was sent in its creating invocation.
table ArtifactOutput {
  port:string (id: 0, required);
  /// Relative to the port value, for example ".files[0]".
  value_path:string (id: 1, required);
}

table ArtifactInfo {
  artifact_id:string (id: 0, required);
  run_id:string (id: 1, required);
  card:Tsugumi.Data.CardPath (id: 2, required);
  invocation:uint64 = null (id: 3);
  size_bytes:uint64 = null (id: 4);
  tree_hash:string (id: 5);
  members:[ArtifactMember] (id: 6, required);
  /// `<invocation sequence>.<k>`, next to the uuid for people.
  label:string (id: 7);
  /// Created without keep: removed with its record when its run ends.
  keep:bool (id: 8);
  outputs:[ArtifactOutput] (id: 9);
  invocation_count:ulong = null (id: 10);
  relative_location:string (id: 11);
}

table ArtifactPage {
  artifacts:[ArtifactInfo] (id: 0, required);
  next_cursor:string (id: 1);
}

table LogSlice {
  text:string (id: 0, required);
  offset:uint64 = null (id: 1);
  next_offset:uint64 = null (id: 2);
  size_bytes:uint64 = null (id: 3);
  exists:bool = null (id: 4);
  /// More bytes exist outside this slice.
  truncated:bool = null (id: 5);
  /// The invocation omitted log output at this combined limit, in bytes.
  log_truncated_at_bytes:uint64 = null (id: 6);
  /// One plus the number of LF bytes before offset in this stream.
  line_number:uint64 = 1 (id: 7);
  /// Offset is zero or the previous byte is LF.
  starts_line:bool = true (id: 8);
  /// Original log size for a terminal read. Export uses raw offsets and bytes.
  raw_size_bytes:uint64 = null (id: 9);
  /// The terminal redrew cells and this slice replaces the previous window.
  reset:bool = false (id: 10);
}

table ViewSaveResult {
  view_id:string (id: 0, required);
  view_rev:uint64 = null (id: 1);
}

union ReplyPayload {
  HelloResult = 1,
  OpenResult = 2,
  Ack = 3,
  ProjectSnapshot = 4,
  SaveResult = 5,
  ProjectValidateResult = 6,
  ProjectCacheClearResult = 8,
  OperationResult = 9,
  SourcePage = 10,
  SourceInfo = 11,
  FileContent = 12,
  EvaluateNixResult = 14,
  RunPlanResult = 15,
  RunAccepted = 16,
  RunStatus = 17,
  RunPage = 18,
  InvocationPage = 19,
  RecordResult = 20,
  ArtifactPage = 21,
  LogSlice = 22,
  ViewSaveResult = 23,
  Failure: Tsugumi.Data.Failure = 24,
  RunHistoryDeleteResult = 25,
  OutputTypesResult = 26,
  VersionResult = 27,
  VersionGraph = 28,
  VersionCanvas = 29,
  NixPathLockedSource = 31,
  RewrittenParamLiteral = 53,
  BuildEnvironmentPage = 32,
  EnvironmentPathPage = 33,
  ProjectShellResult = 34,
  ProjectCacheUsageResult = 36,
  RunScratchDeleteResult = 37,
  CardIdResult = 38,
  VersionNote = 39,
  EnvironmentUsePage = 40,
  ProjectHostRequirements = 41,
  InputTypesResult = 42,
  ProjectActivity = 43,
  TraceSnapshot:Tsugumi.Trace.Snapshot = 44,
  RunDefinitionPaths = 45,
  VersionDiff = 46,
  VersionComments = 47,
  RunCategoryDeleteResult = 48,
}

// ---- Notifications -----------------------------------------------------------

table DocPatched { delta:DocumentDelta (id: 0, required); }

table RunTimeline {
  card:Tsugumi.Data.CardPath (id: 0, required);
  invocation:uint64 = null (id: 1);
  phase:Tsugumi.Data.Phase (id: 2);
  lane:uint32 = null (id: 3);
  start:int64 = null (id: 4);
  end:int64 = null (id: 5);
}

table RunAcceptedEvent { status:RunStatus (id: 0, required); }
table RunStatusChanged { status:RunStatus (id: 0, required); }
table RunCardChanged { invocation:InvocationSummary (id: 0, required); }
table RunBatchChanged { batch:RunBatch (id: 0, required); }
table RunFinished { summary:RunSummary (id: 0, required); }

union RunEventValue {
  RunAcceptedEvent = 1,
  RunStatusChanged = 2,
  RunCardChanged = 3,
  RunTimeline = 4,
  RunFinished = 5,
  RunBatchChanged = 6,
}

table RunEvent {
  run_id:string (id: 0, required);
  value:RunEventValue (id: 2);
}

table DisplayUpdated { display:Tsugumi.Data.Display (id: 0, required); }

/// Sent once to the presenting subscription before any display message.
table ViewOpened {
  session:string (required);
  card:Tsugumi.Data.CardPath (required);
  name:string (required);
  type:string (required);
  mode:uint32;
  width:uint32;
  height:uint32;
  flags:uint32;
}

/// The first process registered for a Card on this window, or the last left.
table ViewRecipientChanged {
  session:string (required);
  path:string (required);
  registered:bool;
}

/// Sent to the presenting subscription when the session closes.
table ViewClosed { session:string (required); }

/// An absent end_offset and unspecified stream indicate invocation log
/// metadata changed without new stream bytes.
table LogAvailable {
  run_id:string (id: 0, required);
  card:Tsugumi.Data.CardPath (id: 1);
  invocation:uint64 = null (id: 2);
  stream:Tsugumi.Data.LogStream (id: 3);
  end_offset:uint64 = null (id: 4);
  live:bool = false (id: 5);
}

union NotificationPayload {
  DocPatched = 1,
  RunEvent = 2,
  DisplayUpdated = 3,
  LogAvailable = 4,
  TraceChanged:Tsugumi.Trace.TraceChanged = 5,
  RunCategoryDeleteResult = 6,
  ViewOpened = 7,
  ViewRecipientChanged = 8,
  ViewClosed = 9,
}

// ---- Frame -------------------------------------------------------------------

table Request { value:RequestPayload (id: 1); }
table Reply { value:ReplyPayload (id: 1); }
table Notification {
  subscription_id:string (id: 0, required);
  seq:uint64 = null (id: 1);
  value:NotificationPayload (id: 3);
}

union Payload { Request = 1, Reply = 2, Notification = 3 }

table Message {
  request_id:uint64 = null (id: 0);  // omitted for notifications
  payload:Payload (id: 2);
}

root_type Message;
file_identifier "TSG1";
