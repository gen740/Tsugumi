// core <-> Card worker protocol. Independent from the external RPC.
// Frames: 4 byte little-endian length + FlatBuffer.
//
// One call at a time per worker. call_id >= 1 and never reused by a worker.
// A call ends with exactly one WorkerResult or WorkerFailure. WorkerDisplay
// uses call_id 0 and is independent of calls.

include "card.fbs";
include "worker_types.fbs";

namespace Tsugumi.Worker;
attribute "trace_secret";

table EnvVar {
  name:string (id: 0, required);
  value:string (id: 1, required, trace_secret);
}

// A declared output: the worker checks names and required presence.
table WorkerPort {
  name:string (id: 0, required);
  required:bool (id: 1);
}

// Private filesystem information for an artifact already granted by core.
table ArtifactGrant {
  id:tsugumi.ArtifactId (required);
  path:string (required);
}

// The worker never opens input or output bytes.
table WorkerCall {
  inputs:[Tsugumi.Card.CardPort] (id: 0, required);
  outputs:[WorkerPort] (id: 1, required);
  // Remaining time in milliseconds. Omitted means no deadline.
  deadline_ms:uint64 = null (id: 2);
  artifact_directory:string (id: 3);
  grants:[ArtifactGrant] (id: 4);
  // Before replying, forward displays queued before a one-shot call returned.
  drain_display:bool (id: 5);
}

table WorkerOutput {
  name:string (id: 0, required);
  bytes:[ubyte] (id: 1);
  artifacts:[tsugumi.ArtifactId] (id: 2);
}

table WorkerResult {
  outputs:[WorkerOutput] (id: 0, required);
  created:[tsugumi.ArtifactId] (id: 1);
}

table WorkerFailure {
  failure:Tsugumi.Data.Failure (id: 0, required);
  created:[tsugumi.ArtifactId] (id: 1);
}

table WorkerCancel {}

// A private launch frame sent before the first call when the Card uses secrets.
table WorkerStart { environment:[EnvVar] (required); }

table WorkerDisplay {
  view:string (id: 0, required);
  bytes:[ubyte] (id: 1, required);
}

// Incremental credit: bytes the receiver has freed for this view.
table WorkerDisplayCredit {
  view:string (required);
  bytes:uint32;
}

union WorkerPayload {
  WorkerCall = 1,
  WorkerResult = 2,
  WorkerFailure = 3,
  WorkerCancel = 4,
  WorkerDisplay = 5,
  WorkerStart = 6,
  WorkerDisplayCredit = 7,
}

table WorkerMessage {
  call_id:uint64 = null (id: 0);
  value:WorkerPayload (id: 2);
}

root_type WorkerMessage;
file_identifier "TSW1";
