  {
    "name": "project_copy",
    "payloadType": "project_copy",
    "description": "Copy an explicit list of files into Card sources without sending bytes through the model. source is attached (registered folder with its own Read grant), card (confirmed project-relative paths, read scope), or scratch (conversation scratch-relative paths). Each files item has from and to (project-relative Card source destination). Supply base_rev from project_inspect. Normal save validation, conflicts, permission widening approval and Agent origin apply. Helpers need source read and destination write scope. Refuses symlinks, traversal and structural documents. Core streams local files without an RPC byte payload or a copy-specific size/count cap; definition-store limits apply (10,000 source entries per project). Data may instead stay attached and be read by a Card with hostFolders (/host/<name>), with permission. Returns destination paths, sizes and SHA-256 hashes, never content.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "files",
        "base_rev"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "attached",
            "card",
            "scratch"
          ]
        },
        "folder": {
          "type": "string"
        },
        "base_rev": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "mutating": true
  },
  {
    "name": "project_save",
    "payloadType": 5,
    "description": "Use project_edit for small changes. project_save is for creating a project and for a large restructuring. ProjectSave: -> SaveResult. Apply all changes in one transaction at base_rev.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "base_rev": {
          "type": "string",
          "pattern": "^-?[0-9]+$",
          "description": "64 bit integer as a decimal string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value_type": {
                "type": "string",
                "enum": [
                  "SetProject",
                  "SetLayout",
                  "PutDefinition",
                  "RemoveDefinition",
                  "PutSource",
                  "PatchSource",
                  "RemoveSource"
                ],
                "description": "variant of value"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "json": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "json"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "json": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "json"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "card_json": {
                        "type": "string"
                      },
                      "meta_json": {
                        "type": "string",
                        "description": " The new _meta.json; omitted removes it unless keep_meta. Empty keeps it."
                      },
                      "keep_meta": {
                        "type": "boolean",
                        "description": " Keep _meta.json as it is (meta_json omitted): change settings without  writing the intent text again."
                      },
                      "fill_description": {
                        "type": "string",
                        "description": "Fill an empty description, preserving existing text."
                      },
                      "fill_context": {
                        "type": "string",
                        "description": "Fill an empty context, preserving existing text."
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "card_json"
                    ]
                  },
                  {
                    "type": "object",
