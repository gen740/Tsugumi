// tsugumi.json: a project's canvas, Nix search-path declarations and settings.
//
// Saved as FlatBuffers JSON text (two-space indent, fields in this order) and
// read with the FlatBuffers parser, which is the document's schema check. The
// core checks ids, references and search-path names.
//
// There are no built-in defaults: every field without "Optional" in its
// comment must be written, and a missing one is a load error (scalars are
// declared `= null` so that the core can tell a missing value from a written
// one). Whoever creates a project writes every value.

namespace Tsugumi.Document;

table Endpoint {
  card:string (required);
  /// The Card's port. Absent on a Draft end (Drafts have no named ports) and
  /// required on every other end.
  port:string;
}

table Connection {
  from:Endpoint (required);
  to:Endpoint (required);
}

/// A Card on the canvas. Its id ([a-z][a-z0-9_]{0,63}) is its name and the
/// folder of its own definition (definitions/<id>/), which holds every
/// setting; a subgraph Card's project is externals/<id>/.
table CardInstance {
  id:string (required);
}

table Graph {
  cards:[CardInstance] (required);
  connections:[Connection] (required);
}

/// One outer port of a project used as a Card in Card: its name and the port
/// of one of its Cards.
table BoundaryPort {
  name:string (required);
  card:string (required);
  port:string (required);
}

table Boundary {
  inputs:[BoundaryPort] (required);
  outputs:[BoundaryPort] (required);
}

table NixPathEntry {
  name:string (required);
  url:string (required);
}

table Project {
  /// The project file format. It changes only when the format changes, and
  /// the core refuses a project whose format differs from its own.
  formatVersion:uint = null;
  name:string (required);
  nixPath:[NixPathEntry] (required);
  /// Additional literal project-relative files or folders kept in Tsugumi's
  /// own project versions (not git).
  trackedPaths:[string] (required);
  /// Host policy, carried without affecting execution.
  agentExclude:[string] (required);
  recordLogs:bool = null;
  recordIO:bool = null;
  logLimitBytes:ulong = null;
  outputLimitBytes:ulong = null;
  outputLimitEntries:ulong = null;
  canvas:Graph (required);
  /// Optional: present only in a child project (externals/<id>/), the ports
  /// it has as a Card in Card.
  boundary:Boundary;
}

root_type Project;
