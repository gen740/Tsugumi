// Shared authentication and result vocabulary for the Host and Agent services.
include "rpc_trace.fbs";
namespace Tsugumi.Service;
attribute "trace_secret";
table HelloRequest { token:string (required, trace_secret); client:Tsugumi.Trace.Client; }
table HelloResult { server_id:string (required); principal:string (required); }
// Present when project conversations are locked. Identity is optional when
// the contender cannot verify the process that holds the lock.
table ConversationLock { pid:uint; application:string; }
table Failure { code:string (required); message:string (required); request_id:string; conversation_lock:ConversationLock; }
table Acknowledgement { accepted:bool; }
// Ordinary calls identify a stored provider and a conversation's model choice.
// purpose: guide/summary asks the host to choose provider/model from settings;
// model and use_choices are then ignored.
table ProviderSelection { profile:string (required); provider_id:string; account_profile:string; model:string; use_choices:bool; purpose:string; }

table Usage { input_tokens:ulong; output_tokens:ulong; cache_read_tokens:ulong; cache_write_tokens:ulong; }

table TextResult { text:string; usage:Usage; }

table PermissionKind { id:string (required); label:string (required); icon:string (required); }
