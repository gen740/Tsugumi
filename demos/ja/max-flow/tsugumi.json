{
  "formatVersion": 1,
  "name": "最大流と最小カット",
  "nixPath": [
    {
      "name": "nixpkgs",
      "url": "github:NixOS/nixpkgs/nixos-unstable"
    },
    {
      "name": "tsugumi-kit",
      "url": "github:gen740/tsugumi-kit/main"
    }
  ],
  "trackedPaths": [],
  "agentExclude": [
    ".git",
    ".DS_Store"
  ],
  "recordLogs": true,
  "recordIO": false,
  "logLimitBytes": 134217728,
  "outputLimitBytes": 68719476736,
  "outputLimitEntries": 1000,
  "canvas": {
    "cards": [
      {
        "id": "start"
      },
      {
        "id": "network"
      },
      {
        "id": "flow"
      },
      {
        "id": "cut"
      },
      {
        "id": "verify"
      },
      {
        "id": "whatif"
      },
      {
        "id": "sweep"
      }
    ],
    "connections": [
      {
        "from": {
          "card": "start",
          "port": "out"
        },
        "to": {
          "card": "network",
          "port": "start"
        }
      },
      {
        "from": {
          "card": "network",
          "port": "network"
        },
        "to": {
          "card": "flow",
          "port": "network"
        }
      },
      {
        "from": {
          "card": "flow",
          "port": "flow"
        },
        "to": {
          "card": "cut",
          "port": "flow"
        }
      },
      {
        "from": {
          "card": "cut",
          "port": "cut"
        },
        "to": {
          "card": "verify",
          "port": "cut"
        }
      },
      {
        "from": {
          "card": "cut",
          "port": "cut"
        },
        "to": {
          "card": "whatif",
          "port": "cut"
        }
      },
      {
        "from": {
          "card": "cut",
          "port": "cut"
        },
        "to": {
          "card": "sweep",
          "port": "cut"
        }
      }
    ]
