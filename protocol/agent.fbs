// Conversations, observations and tools of the host-side Agent service.
// Unix: little-endian uint32 length then one buffer. WebSocket: one binary
// buffer, subprotocol tsugumi.agent.v1. Hello authenticates a server-owned
// principal; clients cannot choose their role or grant themselves access.
include "service_common.fbs";
namespace Tsugumi.Agent;

enum Action:ubyte { Resume, Retry, Continue, Compact, Reset }
enum Access:ubyte { Read, Write, Run, CardPermissions, Shell }
enum GrantScope:ubyte { Conversation, Server }

// Conversation-specific selection; global provisioning uses the Host contract.
table ConfigureRequest { provider:Tsugumi.Service.Provider (required); conversation_id:string (required); }

table ConversationCreateRequest { conversation_id:string; project_id:string; role:string; }
table ConversationListRequest { project_id:string; }
table ConversationGetRequest { conversation_id:string (required); }
table ConversationDeleteRequest { conversation_id:string (required); }
table ConversationSearchRequest { project_id:string; text:string (required); }
table SkillReference { name:string (required); resource_id:string (required); path:string (required); }
// text is an explicit user message. Project context is read inside core,
// after authorization, never silently appended by a UI.
table ConversationSendRequest {
  conversation_id:string (required); turn_id:string (required); text:string (required);
  selected_cards:[string]; selected_displays:[string]; skill_names:[string]; intent:string;
  attached_resources:[string];
  skill_references:[SkillReference];
}
table ConversationActionRequest { conversation_id:string (required); action:Action; }
table ConversationCancelRequest { conversation_id:string (required); }
// Durable sequence numbers allow another connection to resume observation.
table EventsRequest { conversation_id:string (required); after_seq:ulong; limit:uint = 200; }
table ToolCatalogRequest {}
table ToolCallRequest { conversation_id:string (required); project_id:string; name:string (required); arguments_json:string (required); op_id:string (required); }
table AccessRequest { project_id:string (required); conversation_id:string; access:Access; scope:GrantScope; reason:string; }
// Resolving/revoking grants requires the human principal, including over Unix.
table AccessResolveRequest { request_id:string (required); allow:bool; }
table AccessRevokeRequest { grant_id:string (required); }
table AccessListRequest { conversation_id:string; }
table DemoListRequest {}
table DemoReadRequest { path:string (required); }

table VersionSummarizeRequest { project_id:string (required); commit:string (required); }
table ConversationSummarizeRequest { conversation_id:string (required); provider:Tsugumi.Service.Provider; }

union RequestPayload {
  HelloRequest:Tsugumi.Service.HelloRequest,
  ConfigureRequest, ConversationCreateRequest, ConversationListRequest, ConversationGetRequest, ConversationDeleteRequest, ConversationSearchRequest, ConversationSendRequest, ConversationActionRequest, ConversationCancelRequest, EventsRequest, ToolCatalogRequest, ToolCallRequest, AccessRequest, AccessResolveRequest, AccessRevokeRequest, AccessListRequest, DemoListRequest, DemoReadRequest, VersionSummarizeRequest, ConversationSummarizeRequest
}
table Request { value:RequestPayload; }

// Content blocks are the provider/model's open-ended JSON data, not envelopes.
table ModelMessage { role:string; content_json:string; display:string; context_summary:bool; provider_content_json:string; provider_api:string; }
table Usage { input_tokens:ulong; output_tokens:ulong; cache_read_tokens:ulong; cache_write_tokens:ulong; }
table ToolRecord { id:string; name:string; arguments_json:string; op_id:string; state:string; result_json:string; is_error:bool; }
table Helper { call_id:string; task:uint; messages:[ModelMessage]; result_json:string; state:string; }
table Conversation {
  id:string (required); title:string; updated_at:long;
  messages:[ModelMessage]; archive:[ModelMessage]; summary:string;
  tools:[ToolRecord]; helpers:[Helper]; usage:Usage;
}
table ConversationResult { conversation:Conversation (required); busy:bool; resumable:bool; continuable:bool; project_id:string; event_seq:ulong; }
table ConversationEntry { id:string; project_id:string; title:string; updated_at:long; busy:bool; }
table ConversationList { conversations:[ConversationEntry]; }
table SearchMatch { session:string; title:string; snippet:string; updated_at:long; }
table SearchResult { matches:[SearchMatch]; }
// Event kinds and metadata are closed protocol data. Only tool input/result
// text may itself contain JSON. Helpers carry the same typed event recursively.
table Event {
  kind:string (required); text:string; message:string; input_json:string;
  id:string; name:string; ok:bool = true; index:uint;
  asked:[string]; event:Event;
}
table SequencedEvent { seq:ulong; event:Event (required); }
table EventsPage { events:[SequencedEvent]; next_seq:ulong; busy:bool; }
// A tool's input schema is an open-ended JSON Schema document.
table Tool { name:string; description:string; input_schema_json:string; }
table ToolCatalog { tools:[Tool]; }
table Image { media_type:string; data:string; }
table ToolResult { text:string; is_error:bool; images:[Image]; }
table AccessResult { id:string (required); }
table AccessEntry { id:string; project_id:string; conversation_id:string; access:Access; scope:GrantScope; reason:string; state:string; }
table Grant { id:string; project_id:string; conversation_id:string; access:Access; active:bool; }
table AccessList { requests:[AccessEntry]; grants:[Grant]; }
table DemoList { paths:[string]; }
table TextResult { text:string; usage:Usage; }
union ReplyPayload {
  HelloResult:Tsugumi.Service.HelloResult, Acknowledgement:Tsugumi.Service.Acknowledgement,
  ConversationResult, ConversationList, SearchResult, EventsPage, ToolCatalog,
  ToolResult, AccessResult, AccessList, DemoList, TextResult,
  Failure:Tsugumi.Service.Failure
}
table Reply { value:ReplyPayload; }
union Payload { Request, Reply }
table Message { request_id:ulong; payload:Payload; }
root_type Message;
file_identifier "TSA1";
