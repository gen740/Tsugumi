{
  "name": "R reports: R Markdown and Quarto",
  "nixPath": [
    {
      "name": "nixpkgs",
      "url": "github:NixOS/nixpkgs/nixos-unstable"
    },
    {
      "name": "tsugumi-kit",
      "url": "github:gen740/tsugumi-kit/main"
    }
  ],
  "canvas": {
    "cards": [
      {
        "id": "start"
      },
      {
        "id": "aggregate"
      },
      {
        "id": "rmarkdown"
      },
      {
        "id": "quarto"
      },
      {
        "id": "archive"
      }
    ],
    "connections": [
      {
        "from": {
          "card": "start",
          "port": "out"
        },
        "to": {
          "card": "aggregate",
          "port": "start"
        }
      },
      {
        "from": {
          "card": "rmarkdown",
          "port": "report"
        },
        "to": {
          "card": "archive",
          "port": "rmarkdown"
        }
      },
      {
        "from": {
          "card": "quarto",
          "port": "report"
        },
        "to": {
          "card": "archive",
          "port": "quarto"
        }
      },
      {
        "from": {
          "card": "aggregate",
          "port": "data"
        },
        "to": {
          "card": "rmarkdown",
          "port": "data"
        }
      },
      {
        "from": {
          "card": "aggregate",
          "port": "data"
        },
        "to": {
          "card": "quarto",
          "port": "data"
        }
      }
    ]
  }
}
