{
  "name": "Data to report",
  "nixPath": [
    {
      "name": "nixpkgs",
      "url": "github:NixOS/nixpkgs/nixos-unstable"
    },
    {
      "name": "tsugumi-kit",
      "url": "github:gen740/tsugumi-kit/main"
    }
  ],
  "canvas": {
    "cards": [
      {
        "id": "start"
      },
      {
        "id": "settings"
      },
      {
        "id": "generate"
      },
      {
        "id": "aggregate"
      },
      {
        "id": "render"
      },
      {
        "id": "archive"
      }
    ],
    "connections": [
      {
        "from": {
          "card": "start",
          "port": "out"
        },
        "to": {
          "card": "settings",
          "port": "start"
        }
      },
      {
        "from": {
          "card": "generate",
          "port": "csv"
        },
        "to": {
          "card": "aggregate",
          "port": "csv"
        }
      },
      {
        "from": {
          "card": "aggregate",
          "port": "summary"
        },
        "to": {
          "card": "render",
          "port": "summary"
        }
      },
      {
        "from": {
          "card": "render",
          "port": "report"
        },
        "to": {
          "card": "archive",
          "port": "report"
        }
      },
      {
        "from": {
          "card": "settings",
          "port": "config"
        },
        "to": {
          "card": "generate",
          "port": "config"
        }
      },
      {
        "from": {
          "card": "settings",
          "port": "config"
        },
        "to": {
          "card": "render",
          "port": "config"
        }
      }
    ]
  }
}
