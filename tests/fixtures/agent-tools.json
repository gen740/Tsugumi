 {
  "name": "project_validate",
  "payloadType": 7,
  "description": "ProjectValidate: -> ValidationResult. targets = [] means everything; mode = executable.  With `changes` (the same as project_save's), the document as it would be  after them is checked and nothing is saved: try definitions, _outputs.fbs  and default.nix text here instead of saving trial versions.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "at_rev": {
     "type": "string",
     "pattern": "^-?[0-9]+$",
     "description": " Omitted: the latest revision."
    },
    "targets": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "segments": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      },
      "additionalProperties": false,
      "required": [
       "segments"
      ]
     }
    },
    "mode": {
     "type": "string",
     "enum": [
      "unspecified",
      "structure",
      "executable"
     ]
    },
    "changes": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "value_type": {
        "type": "string",
        "enum": [
         "SetProject",
         "SetLayout",
         "PutDefinition",
         "RemoveDefinition",
         "PutSource",
         "PatchSource",
         "RemoveSource",
         "RenameDefinition"
        ],
        "description": "variant of value"
       },
       "value": {
        "anyOf": [
         {
          "type": "object",
          "properties": {
           "json": {
            "type": "string"
           }
          },
          "additionalProperties": false,
          "required": [
           "json"
          ]
         },
         {
          "type": "object",
          "properties": {
           "json": {
            "type": "string"
           }
          },
          "additionalProperties": false,
          "required": [
           "json"
          ]
         },
         {
          "type": "object",
          "properties": {
           "id": {
            "type": "string"
           },
           "card_json": {
            "type": "string"
           },
           "meta_json": {
            "type": "string",
            "description": " The new _meta.json; omitted removes it unless keep_meta."
           },
           "link_json": {
            "type": "string"
           },
           "keep_meta": {
            "type": "boolean",
            "description": " Keep _meta.json as it is (meta_json omitted): change settings without  writing the intent text again."
           }
          },
          "additionalProperties": false,
          "required": [
           "id",
           "card_json"
          ]
         },
         {
          "type": "object",
          "properties": {
           "id": {
            "type": "string"
           }
          },
          "additionalProperties": false,
          "required": [
           "id"
          ]
         },
         {
          "type": "object",
          "properties": {
           "path": {
            "type": "string"
           },
           "bytes": {
            "type": "string",
            "description": "UTF-8 text (or {\"base64\": ...})"
           },
           "base_hash": {
            "type": "string"
           }
          },
          "additionalProperties": false,
          "required": [
           "path",
           "bytes"
          ]
         },
         {
          "type": "object",
          "properties": {
           "path": {
            "type": "string"
           },
           "base_hash": {
            "type": "string"
           },
           "patches": {
            "type": "array",
            "items": {
             "type": "object",
             "properties": {
              "offset": {
               "type": "string",
               "pattern": "^-?[0-9]+$",
               "description": "64 bit integer as a decimal string"
              },
              "remove": {
               "type": "string",
               "pattern": "^-?[0-9]+$",
               "description": "64 bit integer as a decimal string"
              },
              "text": {
               "type": "string"
              }
             },
             "additionalProperties": false,
             "required": [
              "text"
             ]
            }
           }
          },
          "additionalProperties": false,
          "required": [
           "path",
           "base_hash",
           "patches"
          ]
         },
         {
          "type": "object",
          "properties": {
           "path": {
            "type": "string"
           },
           "base_hash": {
            "type": "string"
           }
          },
          "additionalProperties": false,
          "required": [
           "path",
           "base_hash"
          ]
         },
         {
          "type": "object",
          "properties": {
           "id": {
            "type": "string"
           },
           "to": {
            "type": "string"
           }
          },
          "additionalProperties": false,
          "required": [
           "id",
           "to"
          ]
         }
        ]
       }
      },
      "additionalProperties": false
     },
     "description": " Proposed changes (as in project_save): checked, never saved."
    }
   },
   "additionalProperties": false
  },
  "mutating": false
 },
