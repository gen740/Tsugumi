---
import path from 'node:path'
import Icon from './Icon.astro'
import { catalog, STORY, OFF_THE_LIST, REPO, titleOf } from '../lib/documents.mjs'
const { out } = Astro.props
const { groups, pages } = catalog()
const href = to => to === out ? '#' : path.relative(path.dirname(out), to)
const navigation = [
  { title: 'Learn about Tsugumi', items: STORY.filter(s => s.know).map(s => ({ out: s.out, title: s.navTitle ?? s.title ?? titleOf(s.source) })) },
  ...groups.map(g => ({ title: g.title, items: g.docs
    .filter(d => !OFF_THE_LIST.has(d) && !STORY.some(s => s.know && s.source === d))
    .map(d => ({ out: pages.get(d), title: titleOf(d) })) })),
]
---
<nav class="side" aria-label="Documents">
  <div class="brand">
    <a href={href('index.html')}><img src={href('assets/tsugumi-icon.svg')} alt="" width="28" height="28" />Tsugumi</a>
    <span class="brand-links">
      <a class="repo" href={REPO} rel="noopener"><Icon name="github" />GitHub</a>
      <button type="button" class="side-close" aria-label="Close the sidebar" title="Close the sidebar"><Icon name="panel" /></button>
    </span>
  </div>
  <details class="nav-fold" open>
    <summary>Documents</summary>
    {navigation.map(group => <div class="nav-group">
      <h2>{group.title}</h2>
      <ul>{group.items.map(item => <li class:list={{ on: item.out === out }} aria-current={item.out === out ? 'page' : undefined}>
        <a href={href(item.out)}>{item.title}</a>
      </li>)}</ul>
    </div>)}
  </details>
  <script is:inline>
    {
      const fold = document.currentScript.previousElementSibling;
      const narrow = matchMedia('(max-width: 820px)');
      const set = () => { fold.open = !narrow.matches };
      set(); narrow.addEventListener('change', set);
      const side = fold.parentElement, on = fold.querySelector('li.on');
      if (on && on.offsetTop + on.offsetHeight > side.clientHeight) side.scrollTop = on.offsetTop - side.clientHeight / 2;
      const root = document.documentElement;
      const turn = closed => {
        root.classList.toggle('side-closed', closed);
        try { localStorage.setItem('tsugumi.side', closed ? 'closed' : 'open') } catch {}
      };
      side.querySelector('.side-close').addEventListener('click', () => turn(true));
      document.querySelector('.side-open').addEventListener('click', () => turn(false));
    }
  </script>
</nav>
