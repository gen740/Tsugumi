// Conversations, observations and tools of the host-side Agent service.
// Unix: little-endian uint32 length then one buffer. WebSocket: one binary
// buffer, subprotocol tsugumi.agent.v1. Hello authenticates a server-owned
// principal; clients cannot choose their role or grant themselves access.
include "service_common.fbs";
namespace Tsugumi.Agent;

enum Action:ubyte { Resume, Retry, Continue, Compact, Reset }

// Conversation-specific selection; global provisioning uses the Host contract.
table ConfigureRequest { provider:Tsugumi.Service.ProviderSelection (required); conversation_id:string (required); }

table ConversationCreateRequest { conversation_id:string; project_id:string; role:string; }
table ConversationListRequest { project_id:string; }
// Reading or observing a conversation never starts or resumes a turn.
table ConversationGetRequest { conversation_id:string (required); }
table ConversationDeleteRequest { conversation_id:string (required); }
table ConversationSearchRequest { project_id:string; text:string (required); }
// text is an explicit user message. Project context is read inside core,
// after authorization, never silently appended by a UI.
table ConversationSendRequest {
  conversation_id:string (required); turn_id:string (required); text:string (required);
  selected_cards:[string]; selected_displays:[string]; skill_names:[string]; intent:string;
  attached_resources:[string];
  // Human-visible text, before core attaches references and skill contents.
  display:string;
  // Explicit direct helper start. Requires one declared Skill and selected Cards.
  scoped_skill:string;
}
// Resume is an explicit user request; restart/reconnect never sends it.
table ConversationActionRequest { conversation_id:string (required); action:Action; }
table ConversationCancelRequest { conversation_id:string (required); }
// Durable sequence numbers allow another connection to resume observation.
table EventsRequest { conversation_id:string (required); after_seq:ulong; limit:uint = 200; }
table ToolCatalogRequest {}
// Reserve a durable conversation call number before dispatch, so connection
// retries and approval retries can reuse it. Not exposed as a model tool.
table CallIdRequest { conversation_id:string (required); name:string; arguments_json:string; }
table CallId { id:string (required); }
table ToolCallRequest { conversation_id:string (required); project_id:string; name:string (required); arguments_json:string (required); op_id:string (required); }
// Cancels only this connection's in-flight ToolCallRequest, including a queued
// call. It interrupts the call's wait, not the project run it may have started.
table ToolCallCancelRequest { request_id:ulong; }
table AccessRequest { project_id:string (required); conversation_id:string; access:Tsugumi.Service.Access; reason:string; }
// Resolving/revoking grants requires the human principal, including over Unix.
// The host applies the selected offered permissions; omission uses the needed access.
table AccessResolveRequest { request_id:string (required); allow:bool; selected:[Tsugumi.Service.Access]; }
table AccessRevokeRequest { grant_id:string (required); }
table AccessListRequest { conversation_id:string; }

// Shows a project (and a Card in it) in a UI attached to this host, for the
// user or an Agent. hostd validates and remembers the folder (create: a new
// empty project when it does not exist yet), starts its environment and
// tells a page that shows it or is on Home (PageShow). With no UI free, it
// opens the Web UI with the system's opener when browser is set. Without a
// path it shows Home. url is the Web UI; only the user's principal gets one
// that carries the page key. Showing grants no access to the contents.
table ShowRequest { path:string; card:string; create:bool; browser:bool = true; }
table Shown { path:string; project_id:string; shown:bool; opened:bool; url:string; }

table ConversationSummarizeRequest { conversation_id:string (required); provider:Tsugumi.Service.ProviderSelection; }

union RequestPayload {
  HelloRequest:Tsugumi.Service.HelloRequest,
  ConfigureRequest, ConversationCreateRequest, ConversationListRequest, ConversationGetRequest, ConversationDeleteRequest, ConversationSearchRequest, ConversationSendRequest, ConversationActionRequest, ConversationCancelRequest, EventsRequest, ToolCatalogRequest, ToolCallRequest, AccessRequest, AccessResolveRequest, AccessRevokeRequest, AccessListRequest, ConversationSummarizeRequest, ToolCallCancelRequest, CallIdRequest, ShowRequest
}
table Request { value:RequestPayload; }

// Content blocks are the provider/model's open-ended JSON data, not envelopes.
table ModelMessage { role:string; content_json:string; display:string; context_summary:bool; provider_content_json:string; provider_api:string; }
table ToolRecord { id:string; name:string; arguments_json:string; state:string; result_json:string; is_error:bool; }
table Helper { call_id:string; task:uint; spec_json:string; anchor:uint; messages:[ModelMessage]; result_json:string; state:string; }
// Host-built presentation shared by live observation and restored history.
// A row is text (role), step, tool or helper. Children preserve causal order.
table ChatLink { title:string; url:string; }
table ChatRow {
  id:string; kind:string; role:string; text:string; name:string;
  arguments:string; result:string; state:string; archived:bool;
  summary_ja:string; summary_en:string; scope_ja:string; scope_en:string;
  instruction:string; failed:uint; recovered:uint;
  links:[ChatLink]; children:[ChatRow];
}
table AccessLine { request:string; operation:string; needed_now:bool; }
table AccessGroup { title:string; path:string; display_path:string; lines:[AccessLine]; }
table Conversation {
  id:string (required); title:string; updated_at:long;
  messages:[ModelMessage]; archive:[ModelMessage]; summary:string;
  tools:[ToolRecord]; helpers:[Helper]; rows:[ChatRow]; usage:Tsugumi.Service.Usage;
}
// Core-recorded operation at interruption, not inferred from transcript by clients.
// kind: preparing, model, tool, compact. Tool details identify the in-flight call.
table InterruptedOperation { kind:string (required); id:string; name:string; arguments_json:string; }
// The resolved model of the latest accepted turn, without credentials.
table ModelBinding { provider_id:string; model:string; effort:string; fast:bool; }
table ConversationResult { conversation:Conversation (required); busy:bool; resumable:bool; continuable:bool; project_id:string; event_seq:ulong; interrupted_operation:InterruptedOperation; model_binding:ModelBinding; }
table ConversationEntry { id:string; project_id:string; title:string; updated_at:long; busy:bool; }
table ConversationList { conversations:[ConversationEntry]; }
table SearchMatch { session:string; title:string; snippet:string; updated_at:long; }
table SearchResult { matches:[SearchMatch]; }
// Event kinds and metadata are closed protocol data. Only tool input/result
// text may itself contain JSON. Helpers carry the same typed event recursively.
table Event {
  kind:string (required); text:string; message:string; input_json:string;
  id:string; name:string; ok:bool = true; index:uint;
  asked:[string]; groups:[AccessGroup]; event:Event; code:string;
}
table SequencedEvent { seq:ulong; event:Event (required); }
table EventsPage { events:[SequencedEvent]; next_seq:ulong; busy:bool; rows:[ChatRow]; has_rows:bool; }
// A tool's input schema is an open-ended JSON Schema document.
table Tool { name:string; description:string; input_schema_json:string; }
table ToolCatalog { tools:[Tool]; }
table Image { media_type:string; data:string; }
table ToolResult { text:string; is_error:bool; images:[Image]; }
table AccessResult { id:string (required); }
table AccessEntry { id:string; project_id:string; conversation_id:string; access:Tsugumi.Service.Access; reason:string; state:string; asked:[string]; groups:[AccessGroup]; project_path:string; }
table Grant { id:string; project_id:string; access:Tsugumi.Service.Access; active:bool; }
table AccessList { requests:[AccessEntry]; grants:[Grant]; }
union ReplyPayload {
  HelloResult:Tsugumi.Service.HelloResult, Acknowledgement:Tsugumi.Service.Acknowledgement,
  ConversationResult, ConversationList, SearchResult, EventsPage, ToolCatalog,
  ToolResult, AccessResult, AccessList, TextResult:Tsugumi.Service.TextResult,
  Failure:Tsugumi.Service.Failure, CallId, Shown
}
table Reply { value:ReplyPayload; }
union Payload { Request, Reply }
table Message { request_id:ulong; payload:Payload; }
root_type Message;
file_identifier "TSA1";
