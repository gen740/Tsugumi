{
  "type": "code",
  "symbol": "chevron.left.forwardslash.chevron.right",
  "inputs": [
    {
      "name": "input"
    },
    {
      "name": "events"
    }
  ],
  "maxRuns": 1,
  "reuseWorker": false,
  "timeoutSeconds": 0,
  "buildTimeoutSeconds": 0,
  "recordLogs": "project",
  "recordIO": "project",
  "sandbox": {
    "filesystem": true,
    "pid": true,
    "ipc": true,
    "identity": true,
    "limits": {
      "cpu": 0,
      "memoryMiB": 0
    }
  },
  "grants": {
    "network": false,
    "gui": false
  },
  "system": "aarch64-linux",
  "workerCapabilities": []
}
