# Pinned versions for building the shared VM (build-image.sh).
# Apple container CLI/runtime the builder is run with:
TSUGUMI_CONTAINER_VERSION=0.6.0
# Minimum macOS: Apple container 0.6 requires macOS 26.
TSUGUMI_MIN_MACOS=26.0
# Builder image: Nix in a container builds the VM's Linux parts.
TSUGUMI_BUILDER_IMAGE=docker.io/nixos/nix:2.31.2
