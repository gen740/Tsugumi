{
  "name": "tsugumi-web",
  "private": true,
  "version": "1.0.0",
  "description": "Tsugumi web UI: a browser client of tsugumid and a small host launcher",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "sh scripts/gen.sh",
    "build": "sh scripts/build-client.sh && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p .",
    "contract": "node scripts/contract.mjs",
    "check:chatgpt": "node scripts/contract.mjs chatgpt",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "flatbuffers": "25.9.23",
    "katex": "0.19.0",
    "marked": "18.1.1",
    "parse5": "8.1.1",
    "plotly.js-dist-min": "3.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@webgpu/types": "^0.1.66",
    "dom-to-svg": "^0.12.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
