{
  "name": "marimo notebook → typed result",
  "nixPath": [
    {
      "name": "nixpkgs",
      "url": "github:NixOS/nixpkgs/nixos-unstable"
    },
    {
      "name": "tsugumi-kit",
      "url": "github:gen740/tsugumi-kit/main"
    }
  ],
  "canvas": {
    "cards": [
      {
        "id": "start"
      },
      {
        "id": "source"
      },
      {
        "id": "notebook"
      },
      {
        "id": "result"
      }
    ],
    "connections": [
      {
        "from": {
          "card": "start",
          "port": "out"
        },
        "to": {
          "card": "source",
          "port": "start"
        }
      },
      {
        "from": {
          "card": "source",
          "port": "value"
        },
        "to": {
          "card": "notebook",
          "port": "data"
        }
      },
      {
        "from": {
          "card": "notebook",
          "port": "value"
        },
        "to": {
          "card": "result",
          "port": "in"
        }
      }
    ]
  }
}
