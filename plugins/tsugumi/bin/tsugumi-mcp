#!/bin/sh
# Starts the plugin's MCP server (`tsugumi mcp`) from a built Tsugumi
# checkout: the one set in the plugin's options, else the checkout this
# plugin folder is in (a plugin loaded from a checkout rather than from
# Claude Code's cache).
here=$(cd "$(dirname "$0")" && pwd)
for repo in "$1" "$here/../../.."; do
  if [ -n "$repo" ] && [ -x "$repo/build/cli/tsugumi" ]; then
    exec "$repo/build/cli/tsugumi" mcp
  fi
done
echo "tsugumi: no built Tsugumi checkout found (build/cli/tsugumi). Build it (docs/claude-code.md) and set the plugin's \"Tsugumi checkout\" option." >&2
exit 1
