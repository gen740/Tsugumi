  "hostTools": [
    {
      "name": "version_diff",
      "description": "Read the code and settings diff of a saved version against its first parent, or against from_commit. Covers tsugumi.json, Card definitions and code in src/; data files and layout.json are left out. Long diffs are cut (truncated).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "commit": {
            "type": "string"
          },
          "from_commit": {
            "type": "string"
          }
        },
        "required": [
          "commit"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "version_find",
      "description": "Narrow recorded history to past trials without a run id. Lists versions that changed card (a Card key; newest first, kinds narrows how), each version's runs and what observe (default card) recorded in them: its latest invocation's outputs by content hash, compared as same, changed or unknown with the newest run of an earlier version that recorded observe. Results carry card:, run: and invocation links and say what could not be read. A different hash says only that content differs; read the values with run_record and run_value_read. limit is the number of versions, default 10, max 30.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "card": {
            "type": "string"
          },
          "observe": {
            "type": "string"
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "source",
                "parameters",
                "definition",
                "wiring",
                "added",
                "removed"
              ]
            }
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "card"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tool_result_read",
      "description": "Read saved tool output by call_id. Returns text, next_offset, total_bytes and eof; offsets are UTF-8 bytes, pages default/max 2048 bytes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "call_id": {
            "type": "string"
          },
          "offset": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "limit_bytes": {
            "type": "integer"
          }
        },
        "required": [
          "call_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "attached_folder_read",
      "description": "Read a registered folder: a file page with total size and next offset, or sorted directory entries. folder is its registered absolute path; path is relative. Pages default to 256 KiB, max 1 MiB.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "folder": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "offset": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "limit_bytes": {
            "type": "integer"
          }
        },
        "required": [
          "folder",
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "project_copy",
      "mutating": true,
      "description": "Copy files into Card sources without loading bytes into the model, import an attached project into externals (folder + id), or copy a Card and its complete definition closure from an attached project or bundled demo. source: attached (folder + files, folder + id, or folder + card + id), card or scratch (files), demo (demo = language-qualified demo_list path, card = source Card id, id = destination Card id); Card copies accept optional name; Card copies and project imports accept project_path, x, y. base_rev is the inspected revision.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "base_rev"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "attached",
              "card",
              "scratch",
              "demo"
            ]
          },
          "folder": {
            "type": "string"
          },
          "base_rev": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              }
            }
          },
          "demo": {
            "type": "string"
          },
          "card": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "project_path": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
    {
      "name": "project_edit",
      "mutating": true,
      "description": "Apply guarded changes atomically; returns the save result. Structured selectors use field for object members or match for array keys; old_value/new_value use present to distinguish absence from a JSON value. Text replacement expects one match unless expected_matches is given. File put/remove/move use inspected hashes or missing flags. Examples: demo_read reference/cards.md.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "edits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "file_path": {
                      "type": "string"
                    },
                    "selector": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string"
                          },
                          "match": {
                            "type": "object"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "old_value": {
                      "type": "object",
                      "properties": {
                        "present": {
                          "type": "boolean"
                        },
                        "value": {}
                      },
                      "required": [
                        "present"
                      ],
                      "additionalProperties": false
                    },
                    "new_value": {
                      "type": "object",
                      "properties": {
                        "present": {
                          "type": "boolean"
                        },
                        "value": {}
                      },
                      "required": [
                        "present"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "file_path",
                    "selector",
                    "old_value",
                    "new_value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "file_path": {
                      "type": "string"
                    },
                    "old_string": {
                      "type": "string"
                    },
                    "new_string": {
                      "type": "string"
                    },
                    "expected_matches": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "file_path",
                    "old_string",
                    "new_string"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "file_path": {
                      "type": "string"
                    },
                    "put": {
                      "type": "string"
                    },
                    "expected_hash": {
                      "type": "string"
                    },
                    "expect_missing": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "file_path",
                    "put"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "file_path": {
                      "type": "string"
                    },
                    "remove": {
                      "type": "boolean",
                      "const": true
                    },
                    "expected_hash": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "file_path",
                    "remove",
                    "expected_hash"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "file_path": {
                      "type": "string"
                    },
                    "move_to": {
                      "type": "string"
                    },
                    "expected_hash": {
                      "type": "string"
                    },
                    "expected_destination_hash": {
                      "type": "string"
                    },
                    "destination_missing": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "file_path",
                    "move_to",
                    "expected_hash"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "edits"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "project_connect",
      "mutating": true,
      "description": "Connect Card ports atomically. An output can feed several inputs. Replaces the wire at the destination input, or adds a wire to a Draft. Returns the save result. project_path selects an external project; omitted means root.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_path": {
            "type": "string"
          },
          "from_card": {
            "type": "string"
          },
          "from_port": {
            "type": "string"
          },
          "to_card": {
            "type": "string"
          },
          "to_port": {
            "type": "string"
          }
        },
        "required": [
          "from_card",
          "from_port",
          "to_card",
          "to_port"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "project_make_subgraph",
      "mutating": true,
      "description": "Move Cards and their sources into a Card in Card atomically; returns the save result. Reserve id with card_id. project_path selects an external project; omitted means root.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_path": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "cards",
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "project_layout",
      "mutating": true,
      "description": "Arrange Card positions or untangle port order atomically; returns the save result. project_path selects an external project; omitted means root.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_path": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "arrange",
              "untangle"
            ]
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "template_list",
      "description": "List available Project and Host templates with their exact names and store identifiers.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "template_copy",
      "description": "Copy a stored template into the workflow with fresh Card IDs and its internal wiring. Choose an exact name and store from template_list.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "store": {
            "type": "string",
            "enum": [
              "project",
              "host"
            ]
          },
          "name": {
            "type": "string"
          },
          "project_path": {
            "type": "string",
            "description": "Relative external workflow path. Omit for the root workflow."
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "store",
          "name"
        ]
      },
      "mutating": true
    },
    {
      "name": "template_add",
      "description": "Request the person’s approval to add a local template folder to the chosen store.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "store": {
            "type": "string",
            "enum": [
              "project",
              "host"
            ]
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Absolute folder path on the host."
          }
        },
        "required": [
          "store",
          "name",
          "path"
        ]
      },
      "mutating": true,
      "approval_required": true
    },
    {
      "name": "template_import",
      "description": "Request the person’s approval to import a template from a public HTTPS Git repository.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "store": {
            "type": "string",
            "enum": [
              "project",
              "host"
            ]
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "description": "A branch, tag, or commit."
          },
          "subdirectory": {
            "type": "string",
            "description": "Repository-relative path to the template folder."
          }
        },
        "required": [
          "store",
          "name",
          "url",
          "ref",
          "subdirectory"
        ]
      },
      "mutating": true,
      "approval_required": true
    }
  ],
  "runWait": {
    "description": "Returns still_running and wait_reason (ended, timeout or idle).",
    "schema": {
      "type": "integer",
      "minimum": 0,
      "description": "Wait up to this many seconds for completion (max 300); default 0 returns immediately."
    }
  },
  "saveNote": "Whole-document changes for project creation or restructuring; small edits use project_edit. Stale base_rev is refused. PutDefinition keep_meta preserves metadata; fill_description/fill_context fill empty fields. PutSource base_hash guards replacement. Examples: demo_read reference/cards.md.",
  "hostRequests": [
    "LayoutValidateRequest"
  ],
  "approvalRequests": [
    "RunHistoryDeleteRequest",
    "ProjectCacheClearRequest",
    "RunScratchDeleteRequest",
    "VersionCheckoutRequest",
    "VersionInitRequest",
    "VersionMarkRequest"
  ],
