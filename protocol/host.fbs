// Human-only host operations, independent of project/conversation lifetimes.
// Unix: little-endian uint32 length then one buffer. WebSocket: one binary
// buffer, subprotocol tsugumi.host.v1. The external Agent token is rejected.
include "service_common.fbs";
namespace Tsugumi.Host;
// Every optional list in this contract is empty when its vector is omitted.

// Host settings are patched against a revision, never overwritten blindly.
table Setting { key:string (required); value_json:string (required); }
table SettingsGetRequest { profile:string (required); }
table SettingsUpdateRequest { profile:string (required); revision:ulong; changes:[Setting]; client:string; }
table Settings { revision:ulong; values:[Setting]; }
table ProviderSetRequest { profile:string (required); id:string (required); provider:Tsugumi.Service.ProviderInput; remove:bool; ephemeral:bool; }
table ProviderStatusRequest { profile:string (required); id:string (required); }
table ProviderStatus { id:string (required); configured:bool; endpoint:string; source:string; }
table SignInBeginRequest { profile:string (required); client_id:string; consent:bool; issuer:string; resource:string; }
table SignInBegin { attempt_id:string (required); url:string (required); }
table SignInActionRequest { profile:string (required); attempt_id:string; action:string (required); client_id:string; }
table SignInStatusRequest { profile:string (required); attempt_id:string; }
table Account { client_id:string (required); email:string; signed_in:bool; plan_enabled:bool; active:bool; }
table SignInStatus { attempt_id:string; state:string (required); message:string; accounts:[Account]; welcome:string; revoked:bool; }
// Environments outlive clients and agentd restarts. Stop is explicit. Start
// replaces origins/folders; State and Stop do not change either list.
enum EnvironmentAction:ubyte { State, Start, Stop, Folders }
enum EnvironmentPhase:ubyte { Stopped, Starting, Ready, Failed }
table EnvironmentRequest {
  project:string (required);
  action:EnvironmentAction;
  origins:[string];
  folders:[string];
  archive_incompatible_history:bool;
}
table EnvironmentState {
  project:string (required);
  key:string (required);
  phase:EnvironmentPhase;
  endpoint:string;
  token:string;
  project_id:string;
  server_instance_id:string;
  unix_socket:string;
  pid:long;
  control_dir:string;
  ready_file:string;
  message:string;
  recovery:string;
  log:string;
  // The daemon's structured history mismatch diagnostic, for explicit recovery.
  startup_error_json:string;
  execution_scope_unavailable:bool;
}
table EnvironmentProgress { project:string (required); key:string (required); stage:string (required); fraction:double = null; preparing:bool; }
table EnvironmentStopped { state:EnvironmentState (required); }
// Native hosts report vm_state="unavailable"; no VM is booted by this query.
// Command carries the operator tool's explicit supervisor diagnosis. Project
// UIs use EnvironmentRequest; ordinary state queries do not boot a VM.
enum RuntimeAction:ubyte { State, Shutdown, CleanupStore, Histories, DeleteHistory, Reset, DeleteEnvironment, Command }
table HostRuntimeRequest { action:RuntimeAction; project_id:string; project:string; command:string; }
table RuntimeHistory { id:string (required); bytes:ulong; last_start_ms:long; running:bool; }
enum TerminalAction:ubyte { Open, Input, Resize, Close }
table HostTerminalRequest { project:string; action:TerminalAction; session:ulong; rows:uint = 24; cols:uint = 80; data:[ubyte]; }
table HostTerminal { session:ulong; }
table HostTerminalData { session:ulong; data:[ubyte]; closed:bool; }
table HostRuntime { vm_state:string (required); store_path:string; store_exists:bool;
  virtualization_supported:bool; image_available:bool; image_version:string;
  stage:string; message:string; console:[string]; bytes:ulong; paths:uint;
  histories:[RuntimeHistory]; environments:uint; vm_removed:bool;
}
union EventPayload { EnvironmentState, EnvironmentProgress, EnvironmentStopped, HostRuntime, HostTerminalData }
table Event { value:EventPayload; }
table RegisterProjectRequest { project_id:string (required); endpoint:string (required); token:string; title:string; path:string; }
table RegisterFolderRequest { project_id:string (required); resource_id:string (required); folder:string (required); title:string; }
// Listing metadata never grants permission to put a skill in a prompt.
// conversation_id records ordered sources for that send; omission only previews.
table SkillsListRequest { project_path:string; folders:[string]; conversation_id:string; }
table Skill { name:string (required); description:string; path:string (required); source_folder:string; attachment_folder:string; status:string (required); }
table SkillFolder { path:string (required); status:string (required); }
table SkillsList { skills:[Skill]; folders:[SkillFolder]; }
// provider_id keeps the existing per-connection catalogs. Only refresh needs
// a provider configuration; ordinary reads never need credentials.
table ModelsListRequest { provider_id:string (required); refresh:bool; profile:string; account_profile:string; key_profile:string; }
table HostProjectDefaultsRequest {}
table HostProjectInfoRequest { path:string (required); }
table HostProjectCreateRequest { parent:string (required); name:string (required); flow:string; }
table HostProjectDuplicateRequest { path:string (required); parent:string (required); name:string (required); }
table HostDemoListRequest { language:string; }
table HostDemoCopyRequest { id:string (required); parent:string (required); language:string; }
table HostRecentListRequest {}
table HostRecentRememberRequest { path:string (required); }
table HostRecentForgetRequest { paths:[string]; }

// One app-wide native session ("desktop") or one session per Web host
// ("web:<support directory>"), shared by every window. Language is presentation.
// Persisted: setup_done, demo_answered, tour. The live step/run observations
// last for the agentd lifetime. No model configuration is needed.
table GuideTour { demo:string (required); title:string (required); path:string (required); started:bool; }
table GuideAction { kind:string (required); label:string (required); demo:string; card:string; }
table GuideGetRequest { session_id:string (required); language:string; }
// kind: connection, setup, introduction, offered, start, end, resume,
// message, interest, observe, action_finished. Clients report screen facts;
// only agentd chooses a script step. expected_step guards stale choices.
table GuideInput {
  kind:string (required); text:string; project:string; demo:string; title:string;
  connected:bool; active:bool; run:string; state:string; scripted:bool = true;
  expected_step:string;
}
table GuideAdvanceRequest { session_id:string (required); language:string; event:GuideInput (required); }
table GuideState {
  session_id:string (required); revision:ulong; answer_revision:ulong; setup_done:bool; demo_answered:bool;
  tour:GuideTour; step:string; text:string; say:string; choices:[string];
  actions:[GuideAction]; highlight:string; open:string; end_tour:bool;
  // present is true only for a new answer; note is the model-mode cue
  // (start/resume/run/disconnected/reconnected), with its display text in asked.
  present:bool; note:string; asked:string; project:string;
}

// Execution services contain public pins only. Private TLS keys never cross RPC.
table ExecutionServicesRequest {}
table ExecutionServicePutRequest { id:string (required); name:string (required); endpoint:string (required); worker_public_key:string (required); verify:bool; }
table ExecutionServiceRemoveRequest { id:string (required); }
// agentd derives identity from the host filesystem, never the document UUID.
// agentd writes the scoped capability into this project's control share.
table ExecutionProjectAuthorizeRequest { project_id:string (required); path:string (required); control_dir:string (required); guest:bool; }
table ExecutionProjectRevokeRequest { project_id:string (required); }
table ExecutionCapabilities { server_id:string (required); native_system:string (required); systems:[string]; isolation:string; resource_limits:bool; max_concurrent_jobs:uint; worker_contract:uint; }
table ExecutionService { id:string (required); name:string (required); endpoint:string (required); worker_public_key:string (required); capabilities:ExecutionCapabilities (required); }
table ExecutionServices { services:[ExecutionService]; host_public_key:string (required); }
table ExecutionAuthorization { endpoint:string (required); capability_file:string (required); available:bool; }

table ProjectDefaults { nixpkgs_pin:string (required); }
table ProjectInfo { path:string (required); name:string (required); }
table ProjectLocation { path:string (required); }
// opened_at is Unix epoch milliseconds. Forget never removes project folders.
table RecentProject { path:string (required); name:string (required); opened_at:long; }
table RecentList { projects:[RecentProject]; }
table Demo { id:string (required); path:string (required); title:string (required); description:string (required); tags:[string]; field:string; }
table DemoList { demos:[Demo]; }
table Model { id:string; name:string; }
table ModelList { models:[Model]; }
/// A comment on a Card that a version or a save changed.
table VersionComment {
  card:string (id: 0, required);
  text:string (id: 1, required);
  /// added, edited, resolved, reopened or removed. A comment written and
  /// resolved within one version is resolved.
  change:string (id: 2, required);
  resolution:string (id: 3);
  /// Who did it, as the comment records it: agent or user. Absent when it is
  /// not recorded, as for a comment that is gone.
  by:string (id: 4);
  /// The Cards the save that resolved it changed.
  cards:[string] (id: 5);
}

// The host reads comment records from the registered project repository.
table VersionCommentsRequest { project:string (required); commit:string (required); }
table VersionComments { comments:[VersionComment]; }

union RequestPayload {
  VersionCommentsRequest,
  GuideGetRequest, GuideAdvanceRequest, HelloRequest:Tsugumi.Service.HelloRequest, EnvironmentRequest, HostRuntimeRequest, HostTerminalRequest, SettingsGetRequest, SettingsUpdateRequest, ProviderSetRequest, ProviderStatusRequest, SignInBeginRequest, SignInActionRequest, SignInStatusRequest,
  ExecutionServicesRequest, ExecutionServicePutRequest, ExecutionServiceRemoveRequest, ExecutionProjectAuthorizeRequest, ExecutionProjectRevokeRequest,
  RegisterProjectRequest, RegisterFolderRequest, SkillsListRequest, ModelsListRequest, HostProjectDefaultsRequest, HostProjectInfoRequest, HostProjectCreateRequest, HostProjectDuplicateRequest, HostDemoListRequest, HostDemoCopyRequest, HostRecentListRequest, HostRecentRememberRequest, HostRecentForgetRequest
}
table Request { value:RequestPayload; }
union ReplyPayload {
  VersionComments,
  HelloResult:Tsugumi.Service.HelloResult, Acknowledgement:Tsugumi.Service.Acknowledgement,
  GuideState, EnvironmentState, HostRuntime, HostTerminal, ExecutionServices, ExecutionAuthorization, Settings, ProviderStatus, SignInBegin, SignInStatus, ProjectDefaults, ProjectInfo, ProjectLocation, RecentProject,
  RecentList, DemoList, SkillsList, ModelList, Failure:Tsugumi.Service.Failure
}
table Reply { value:ReplyPayload; }
union Payload { Request, Reply, Event }
table Message { request_id:ulong; payload:Payload; }
root_type Message;
file_identifier "TSH1";
