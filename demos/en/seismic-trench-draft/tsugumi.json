{
  "formatVersion": 1,
  "name": "Japan Trench · hypocentre sections and the b-value",
  "nixPath": [
    {
      "name": "nixpkgs",
      "url": "github:NixOS/nixpkgs/nixos-unstable"
    },
    {
      "name": "tsugumi-kit",
      "url": "github:gen740/tsugumi-kit/main"
    }
  ],
  "trackedPaths": [],
  "agentExclude": [
    ".git",
    ".DS_Store"
  ],
  "recordLogs": true,
  "recordIO": false,
  "logLimitBytes": 134217728,
  "outputLimitBytes": 68719476736,
  "outputLimitEntries": 1000,
  "canvas": {
    "cards": [
      {
        "id": "start"
      },
      {
        "id": "load"
      },
      {
        "id": "section"
      },
      {
        "id": "b_value"
      }
    ],
    "connections": [
      {
        "from": {
          "card": "start",
          "port": "out"
        },
        "to": {
          "card": "load"
        }
      },
      {
        "from": {
          "card": "load"
        },
        "to": {
          "card": "section"
        }
      },
      {
        "from": {
          "card": "section"
        },
        "to": {
          "card": "b_value"
        }
      }
    ]
  }
}
