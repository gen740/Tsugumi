#!/bin/sh
# The `tsugumi` command on a Mac: a client of the host the desktop app also
# uses, with its projects in the app's shared Linux VM. The same VM, store,
# control folders, recent projects and settings as the app of its channel:
# the release app for a release, Tsugumi Dev otherwise (docs/WebUI.md).
# `tsugumi` alone prints its usage.
set -eu

self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
root="$(cd "$(dirname "$self")" && pwd -P)"

export TSUGUMI_VMHOST="$root/bin/tsugumi-vmhost"
export TSUGUMI_VM_IMAGE="$root/vm"
export TSUGUMI_REPO="$root"
exec "$root/bin/tsugumi" "$@"
