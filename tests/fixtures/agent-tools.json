  {
    "name": "project_edit",
    "payloadType": "project_edit",
    "description": "Use for small project changes. One atomic edit against the current document; unrelated fields stay byte-identical. Structured edits use keyed selectors (field selects an object member; match selects one array entity by stable keys), and old_value/new_value with explicit present and a JSON value. Example: {\"file_path\":\"tsugumi.json\",\"selector\":[{\"field\":\"name\"}],\"old_value\":{\"present\":true,\"value\":\"Before\"},\"new_value\":{\"present\":true,\"value\":\"After\"}}. Sources use exact replacement, e.g. {\"file_path\":\"definitions/work/main.py\",\"old_string\":\"limit = 1\",\"new_string\":\"limit = 2\"}; exactly one match unless expected_matches is explicit. File put/remove/move require the hash read (or expect_missing/destination_missing). Missing, null and empty differ. A conflict changes nothing: inspect the target and submit a new guarded edit. Operation identities are supplied by the runtime.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "file_path": {
                    "type": "string"
                  },
                  "selector": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string"
                        },
                        "match": {
                          "type": "object"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "old_value": {
                    "type": "object",
                    "properties": {
                      "present": {
                        "type": "boolean"
                      },
                      "value": {}
                    },
                    "required": [
                      "present"
                    ],
                    "additionalProperties": false
                  },
                  "new_value": {
                    "type": "object",
                    "properties": {
                      "present": {
                        "type": "boolean"
                      },
                      "value": {}
                    },
                    "required": [
                      "present"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "file_path",
                  "selector",
                  "old_value",
                  "new_value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "file_path": {
                    "type": "string"
                  },
                  "old_string": {
                    "type": "string"
                  },
                  "new_string": {
                    "type": "string"
                  },
                  "expected_matches": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "file_path",
                  "old_string",
                  "new_string"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "file_path": {
                    "type": "string"
                  },
                  "put": {
                    "type": "string"
                  },
                  "expected_hash": {
                    "type": "string"
                  },
                  "expect_missing": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "file_path",
                  "put"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "file_path": {
                    "type": "string"
                  },
                  "remove": {
                    "type": "boolean",
                    "const": true
                  },
                  "expected_hash": {
                    "type": "string"
                  }
                },
                "required": [
                  "file_path",
                  "remove",
                  "expected_hash"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "file_path": {
                    "type": "string"
                  },
                  "move_to": {
                    "type": "string"
                  },
                  "expected_hash": {
                    "type": "string"
                  },
                  "expected_destination_hash": {
                    "type": "string"
                  },
                  "destination_missing": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "file_path",
                  "move_to",
                  "expected_hash"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "edits"
      ],
      "additionalProperties": false
    },
    "mutating": true
  },
