include "card_enums.fbs";
include "artifact.fbs";
namespace Tsugumi.Card;
table CardPort {
  name:string (id: 0, required);
  schema:string (id: 1);          // §2.1; the core stamps it, the SDK may leave it empty in results
  bytes:[ubyte] (id: 2);
  artifacts:[tsugumi.ArtifactId] (id: 3);
}
table CardInput { inputs:[CardPort] (id: 0); }   // arrived connected inputs only; no params
table CardFailure { kind:Tsugumi.Data.FailureKind (id: 0); message:string (id: 1); source:string (id: 2); line:uint32 (id: 3); cell:string (id: 4); }
table CardResult { outputs:[CardPort] (id: 0); failure:CardFailure (id: 1); }

namespace tsugumi.builtin;
table Envelope { schema:string; bytes:[ubyte]; artifacts:[tsugumi.ArtifactId]; }
table Collected { items:[Envelope] (id: 0); }
