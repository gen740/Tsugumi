// Tsugumi project RPC values.
//
// Conventions
// - Required scalars are declared as optional scalars (`= null`) and their
//   presence is checked by semantic validation.
// - Id: opaque string; runs use positive project sequence numbers. Rev/Seq: uint64. Time: int64 UTC epoch ms.
//   Duration: uint64 ms. Hash: lowercase SHA-256 hex. Path: project relative.
// - Maps are vectors of KeyValue; duplicate keys are rejected.

include "worker_types.fbs";

namespace Tsugumi.Data;

/// Values captured at run start, formatted for the comparison view.
table InvocationParam {
  name:string (required);
  value:string (required);
}
table InvocationParams {
  entries:[InvocationParam];
}

// A Card path of permanent identifiers, such as ["nested", "step"].
// Human names are separate; segments never contain '/'.
// The empty path addresses only the graph root and never a Card.
table CardPath {
  segments:[string] (id: 0, required);
}

table Diagnostic {
  severity:Severity (id: 0);
  code:string (id: 1, required);
  message:string (id: 2, required);
  card:CardPath (id: 3);
  path:string (id: 4);
  offset:uint64 = null (id: 5);
}

/// What an artifact id found in a recorded value resolves to now.
/// unavailable: nothing is recorded under the id (an artifact created
/// without keep after its run ended, a deleted artifact, or an id from elsewhere).
enum ArtifactState : ubyte { unspecified = 0, available = 1, unavailable = 2 }

/// An artifact id found in a value (a tsugumi.ArtifactId in its schema).
table ValueArtifact {
  id:string (id: 0, required);
  size_bytes:uint64 = null (id: 1);
  /// `<invocation sequence>.<k>`: the core's number for people.
  label:string (id: 2);
  state:ArtifactState (id: 3);
}

table NamedValue {
  name:string (id: 0, required);
  schema_bfbs:[ubyte] (id: 1, required);
  root_type:string (id: 2, required);
  size_bytes:uint64 = null (id: 3);
  inline_bytes:[ubyte] (id: 4);
  artifacts:[ValueArtifact] (id: 5);
  /// SHA-256 (hex) of a recorded value's bytes.
  content_hash:string (id: 6);
}

// ---- Display ---------------------------------------------------------------

/// A live opaque message.
table Display {
  session:string (id: 0, required);
  bytes:[ubyte] (id: 1, required);
  credit_id:uint64 = null (id: 2);
}

/// The bounded output and result used to rank one worker for a Card.
table WorkerProbeResult {
  worker:string (required);
  probe:string;
  score:double = null;
  failure:string;
  unavailable_reason:string;
  /// What the probe wrote to stdout and stderr, in write order.
  output_text:string;
  measured_at:long;
}
