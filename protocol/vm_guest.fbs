// Guest-initiated vsock 1024. Each frame is a uint32 LE length and a TVG1
// buffer. Events have request_id 0. Replies echo their request's ID.
namespace Tsugumi.VMGuest;

table Start { key:string (required); host_name:string (required); slot:ubyte; rpc_trace:bool; origins:[string]; }
table Stop { key:string (required); }
table Forget { key:string (required); }
table ClearBuildRoots { key:string (required); }
table Clock { unix_ms:long; }
table Resize { session:ulong; rows:ushort; cols:ushort; }
enum MaintenanceAction:ubyte { SnapshotCacheUsage, CollectStore, VerifyStore, Shutdown }
table Maintenance { action:MaintenanceAction; }
table ReadMemory {}

// Terminal vsock 1026 starts with one framed request and reply, then raw PTY bytes.
table OpenTerminal { key:string (required); rows:ushort; cols:ushort; }
union Command { Start, Stop, Forget, Clock, Resize, Maintenance, OpenTerminal, ReadMemory, ClearBuildRoots }
table Request { command:Command (required); }
table Memory { total_kib:ulong; available_kib:ulong; cached_kib:ulong; }
table Reply { error:string; message:string; pid:long; session:ulong; memory:Memory; build_roots_removed:bool; }

table Ready {}
enum ProjectPhase:ubyte { Starting, Ready, Exited }
table ProjectStatus { key:string (required); pid:long; phase:ProjectPhase; exit_status:int = -1; }
table ConsoleLine { text:string (required); }
union Payload { Request, Reply, Ready, ProjectStatus, Memory, ConsoleLine }
table Message { request_id:ulong; payload:Payload (required); }
root_type Message;
file_identifier "TVG1";
