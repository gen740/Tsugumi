// Private inherited Unix connection, one request/reply at a time. Acquire
// replies carry data, control, stdout and stderr descriptors via SCM_RIGHTS.
// No Card bytes pass through this connection. EOF ends this core's workers.
include "worker.fbs";
namespace Tsugumi.LocalWorker;
attribute "trace_secret";
enum Action:ubyte { Acquire, Release, Clear, ClearScratch, Terminate, Invalidate }
table Bind { source:string (required); target:string (required); write:bool; name:string; }
table Spawn {
  worker_binary:string (required); store_path:string (required);
  closure:[string]; shared_vm:bool; secrets:[Tsugumi.Worker.EnvVar];
  package:string;
  filesystem:bool = true; pid:bool = true; ipc:bool = true; identity:bool = true;
  cpu_millis:ulong; memory_bytes:ulong; network:bool; gui:bool;
  ro_paths:[string]; hidden_paths:[string]; binds:[Bind]; uid:uint = null; gid:uint = null;
  artifacts_root:string;
}
table Message {
  action:Action; card:string; key:string (trace_secret); spawn:Spawn; reuse:bool;
  lease:ulong; keep:bool; force:bool; reason:string;
  reused:bool; replaced:string; scratch:string; call_id:ulong; error:string;
  error_kind:Tsugumi.Data.FailureKind = worker_failed;
}
root_type Message;
file_identifier "TSL1";
