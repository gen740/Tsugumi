// Private same-user adapter channel: hostd alone drives the signed VM helper.
// uint32 LE length and one FlatBuffer of at most 16 MiB (the Host RPC frame
// limit: Host requests and replies pass through); independent request
// connections and a Watch connection for progress, runtime snapshots and
// terminal bytes.
include "host.fbs";
include "vm_guest.fbs";
namespace Tsugumi.VMHost;
attribute "trace_secret";
table Watch {}
// resources: used when this Boot starts the VM; a running VM keeps its own.
table Boot { key:string; broker_socket:string (required); cache_configuration:string (trace_secret); cache_netrc:string (trace_secret); cache_problem:string; resources:Tsugumi.Host.VMResources (required); }
table Mount { name:string (required); path:string (required); read_only:bool; }
table Run { key:string (required); mounts:[Mount]; origins:[string]; host_name:string (required); rpc_trace:bool; }
enum ProcessAction:ubyte { Inspect, Stop }
table ProcessRequest { key:string (required); action:ProcessAction; }
union RequestPayload { Watch, Boot, Run, ProcessRequest, Reset, HostRuntimeRequest:Tsugumi.Host.HostRuntimeRequest, HostTerminalRequest:Tsugumi.Host.HostTerminalRequest }
table Request { value:RequestPayload; }
// The host chooses retention; the helper only applies these file operations.
table Reset { keep_files:[string]; discard_other_files:bool; }
table Process { pid:long; running:bool; endpoint:string; }
table Failure { message:string (required); recovery:string; log:string; }
union ReplyPayload { Process, HostRuntime:Tsugumi.Host.HostRuntime, HostTerminal:Tsugumi.Host.HostTerminal, Acknowledgement:Tsugumi.Service.Acknowledgement, Failure }
table Reply { value:ReplyPayload; }
table Progress { key:string (required); stage:string (required); fraction:double = null; preparing:bool; }
union EventPayload { Progress, HostRuntime:Tsugumi.Host.HostRuntime, HostTerminalData:Tsugumi.Host.HostTerminalData, ProjectStatus:Tsugumi.VMGuest.ProjectStatus }
table Event { value:EventPayload; }
union Payload { Request, Reply, Event }
table Message { request_id:ulong; payload:Payload; }
root_type Message;
file_identifier "TSV1";
