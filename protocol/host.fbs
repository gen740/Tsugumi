// Human-only host operations, independent of project/conversation lifetimes.
// Unix: little-endian uint32 length then one buffer. WebSocket: one binary
// buffer, subprotocol tsugumi.host.v1. The external Agent token is rejected.
include "service_common.fbs";
include "tsugumi.fbs";
namespace Tsugumi.Host;
// Every optional list in this contract is empty when its vector is omitted.

// Secret input is accepted only by the human-only Host ProviderSet request.
// context_limit is an optional input-token budget (0 selects the model budget).
// The host reserves max_tokens and a margin from the model context window.
table ProviderInput { endpoint:string; api_key:string; model:string; max_tokens:uint = 16384; context_limit:uint = 0; }

// Host settings are patched against a revision, never overwritten blindly.
// Human-owned binary cache configuration; validation and persistence belong to hostd.
table BinaryCachesGetRequest {}
table BinaryCachesPutRequest { caches_json:string (required); }
table BinaryCaches { caches_json:string (required); }

// Project grants are human-owned and shared by every conversation/helper.
// The host lists editable permissions, including attached folders, and validates edits.
table ProjectPermissionsRequest {}
table ProjectPermissionSetRequest { project_id:string (required); resource_id:string (required); access:Tsugumi.Service.Access; allow:bool; }
table ProjectPermission { resource_id:string (required); title:string; path:string; access:Tsugumi.Service.Access; allowed:bool; }
table ProjectPermissions { project_id:string (required); title:string; path:string; permissions:[ProjectPermission]; }
table ProjectPermissionList { projects:[ProjectPermissions]; }
table ProviderChanged { profile:string (required); }

table Setting { key:string (required); value_json:string (required); }
table SettingsGetRequest { profile:string (required); }
table SettingsUpdateRequest { profile:string (required); revision:ulong; changes:[Setting]; client:string; }
table Settings { revision:ulong; values:[Setting]; }
// ephemeral source: env, keychain, or memory (omitted). The host selects env
// before keychain before memory, then a stored key on Linux only. On macOS
// persistent API-key writes are refused; clients save through the login Keychain.
table ProviderSetRequest { profile:string (required); id:string (required); provider:ProviderInput; remove:bool; ephemeral:bool; source:string; }
// Availability uses exactly the same key policy as model requests.
table ProviderStatusRequest { profile:string (required); id:string (required); key_profile:string; }
// Model choices for guide/summary are read from host settings and catalogs.
// purpose is guide or summary. The reply contains no credentials.
table ModelSelectionRequest { profile:string (required); purpose:string (required); }
table ModelSelection { provider:Tsugumi.Service.ProviderSelection (required); }
// storage tells the platform adapter where an explicit Save must go.
table ProviderStatus { id:string (required); configured:bool; endpoint:string; source:string; storage:string; message:string; }
table SignInBeginRequest { profile:string (required); client_id:string; consent:bool; issuer:string; resource:string; }
table SignInBegin { attempt_id:string (required); url:string (required); }
table SignInActionRequest { profile:string (required); attempt_id:string; action:string (required); client_id:string; }
table SignInStatusRequest { profile:string (required); attempt_id:string; }
table Account { client_id:string (required); email:string; signed_in:bool; plan_enabled:bool; active:bool; }
table SignInStatus { attempt_id:string; state:string (required); message:string; accounts:[Account]; welcome:string; revoked:bool; }
// Environments outlive clients and hostd restarts. Stop is explicit. Start
// updates origins only; folders change through explicit add/remove operations.
enum EnvironmentAction:ubyte { State, Start, Stop, AddFolders, RemoveFolders }
enum EnvironmentPhase:ubyte { Stopped, Starting, Ready, Failed }
enum EnvironmentFailureCode:ubyte { None, ProcessExit, Cancelled, LaunchFailed }
table EnvironmentRequest {
  project:string (required);
  action:EnvironmentAction;
  origins:[string];
  folders:[string];
}
// Host-selected attached roots in the running project environment.
table AttachedRoot { host_path:string (required); execution_path:string (required); }
table EnvironmentState {
  project:string (required);
  key:string (required);
  phase:EnvironmentPhase;
  failure_code:EnvironmentFailureCode;
  endpoint:string;
  token:string;
  project_id:string;
  unix_socket:string;
  pid:long;
  control_dir:string;
  ready_file:string;
  message:string;
  recovery:string;
  log:string;
  // The daemon's structured history mismatch diagnostic, for explicit recovery.
  startup_error_json:string;
  execution_scope_unavailable:bool;
  folders:[string];
  attached_roots:[AttachedRoot];
}
table EnvironmentProgress { project:string (required); key:string (required); stage:string (required); fraction:double = null; preparing:bool; }
table EnvironmentStopped { state:EnvironmentState (required); }
// Native hosts report vm_state="unavailable"; no VM is booted by this query.
// Command carries the operator tool's explicit supervisor diagnosis. Project
// UIs use EnvironmentRequest; ordinary state queries do not boot a VM.
enum RuntimeAction:ubyte { State, Shutdown, CleanupStore, ForgetProject, Reset, DeleteEnvironment, Command, VerifyStore }
// Snapshot for the app's quit confirmation, including work from other clients.
// Connections alone are not work. This neither stops nor transfers any work.
/// -> HostActivity. Agent turns, host requests and project-core activity.
table HostActivityRequest {}
table HostActivity { busy:bool; }
table HostRuntimeRequest { action:RuntimeAction; project_id:string; project:string; command:string; }
enum TerminalAction:ubyte { Open, Input, Resize, Close }
table HostTerminalRequest { project:string; action:TerminalAction; session:ulong; rows:uint = 24; cols:uint = 80; data:[ubyte]; }
table HostTerminal { session:ulong; }
table HostTerminalData { session:ulong; data:[ubyte]; closed:bool; }
table HostRuntime { vm_state:string (required); store_path:string; store_exists:bool;
  virtualization_supported:bool; image_available:bool; image_version:string;
  stage:string; message:string; console:[string]; bytes:ulong; paths:uint;
  environments:uint; vm_removed:bool;
  // Host-authored confirmation of the same policy sent to the VM helper.
  reset_confirmation_ja:string; reset_confirmation_en:string;
  // Actual VM-directory entries kept and discarded by the helper.
  reset_kept_files:[string]; reset_discarded_files:[string];
  // The shared VM's size: what its next start uses (Settings, else the
  // defaults), the defaults and the largest values for this Mac. Set by hostd.
  vm_resources:VMResources; vm_default_resources:VMResources; vm_limits:VMResources;
  // The store disk file now, in GiB (0 before it exists). Set by the helper.
  store_disk_gib:uint;
}
/// CPUs, memory (GiB) and store disk (GiB) of the shared VM.
table VMResources { cpus:uint; memory_gib:uint; store_gib:uint; }
table SettingsChanged { profile:string (required); revision:ulong; }
union EventPayload { EnvironmentState, EnvironmentProgress, EnvironmentStopped, HostRuntime, HostTerminalData, SettingsChanged, ProviderChanged }
table Event { value:EventPayload; }
table RegisterProjectRequest { project_id:string (required); endpoint:string (required); token:string; title:string; path:string; }
// One host operation: validate the batch, update shares, await the new core,
// and register every resource. On failure restore the previous folder set.
// The client reconnects its own project session after this reply.
table AttachFoldersRequest { project:string (required); folders:[string]; }
table FolderAttachment { folder:string (required); resource:string (required); }
table AttachedFolders { state:EnvironmentState (required); folders:[FolderAttachment]; }
table RegisterFolderRequest { project_id:string (required); resource_id:string (required); folder:string (required); title:string; }
// Listing metadata never grants permission to put a skill in a prompt.
// conversation_id records ordered sources for that send; omission only previews.
enum ProjectTrustDecision:ubyte { Unknown, Trusted, Untrusted }
table ProjectTrustRequest { path:string (required); decision:ProjectTrustDecision; }
table ProjectTrust { decision:ProjectTrustDecision; trusted_folder:string; }
table SkillsListRequest { project_path:string; folders:[string]; conversation_id:string; }
table Skill { name:string (required); description:string; path:string (required); source_folder:string; attachment_folder:string; status:string (required); scope:[string]; scoped:bool; always:bool; }
table SkillFolder { path:string (required); status:string (required); }
table SkillsList { skills:[Skill]; folders:[SkillFolder]; }
// provider_id keeps the existing per-connection catalogs. Only refresh needs
// a provider configuration; ordinary reads never need credentials.
table ModelsListRequest { provider_id:string (required); refresh:bool; profile:string; account_profile:string; key_profile:string; }
table HostProjectDefaultsRequest {}
// Binary file payload used by guarded operation inverses.
table ProjectFile { path:string (required); bytes:[ubyte]; }
table HostProjectInfoRequest { path:string (required); }
table HostProjectCreateRequest { parent:string (required); name:string (required); flow:string; }
table HostProjectDuplicateRequest { path:string (required); parent:string (required); name:string (required); }
table HostDemoListRequest { language:string; }
table HostDemoCopyRequest { id:string (required); parent:string (required); language:string; }
table HostRecentListRequest {}
table HostRecentRememberRequest { path:string (required); }
table HostRecentForgetRequest { paths:[string]; }

// Intent editing, shared by all clients. Object fields and keyed array entities
// are selected by identity; numeric array offsets are never entity identities.
table ProjectSelector {
  field:string;
  match_json:string; // nonempty object whose members identify an array entity
}
table ProjectValue { present:bool; json:string; }
table ProjectFieldEdit {
  file_path:string (required);
  selector:[ProjectSelector];
  old_value:ProjectValue (required);
  new_value:ProjectValue (required);
}
table ProjectTextEdit {
  file_path:string (required);
  old_string:string (required);
  new_string:string (required);
  expected_matches:uint32 = 1;
}
table ProjectFilePut {
  file_path:string (required);
  expected_hash:string;
  expect_missing:bool;
  bytes:[ubyte];
}
table ProjectFileRemove { file_path:string (required); expected_hash:string (required); }
table ProjectFileMove {
  file_path:string (required);
  expected_hash:string (required);
  to:string (required);
  expected_destination_hash:string;
  destination_missing:bool;
}
// Replace a complete definition/external folder, guarding its exact file closure.
// Used by transformation undo so a later added file cannot be silently deleted.
table ProjectFileHash { path:string (required); hash:string (required); }
table ProjectTreeEdit { prefix:string (required); expected:[ProjectFileHash]; files:[ProjectFile]; }
// The host extracts guarded field edits from a form's selected before/after values.
// This is not whole-document replacement; raw editors use ProjectReplaceDocuments.
table ProjectJSONEdit { file_path:string (required); old_value:ProjectValue (required); new_value:ProjectValue (required); }
union ProjectEditValue { ProjectFieldEdit, ProjectTextEdit, ProjectFilePut, ProjectFileRemove, ProjectFileMove, ProjectTreeEdit, ProjectJSONEdit }
table ProjectEdit { value:ProjectEditValue; }
table ProjectEdits { edits:[ProjectEdit]; }
table ProjectConnect {
  project_path:string;
  from_card:string (required); from_port:string (required);
  to_card:string (required); to_port:string (required);
  fork_id:string;
}
table ProjectMakeSubgraph { project_path:string; cards:[string]; id:string (required); name:string; }
// Source paths name a definition or an external folder in the current project.
// The host copies its complete document/source closure and places the new Card.
table ProjectCopyItem { from:string (required); id:string (required); name:string; x:double; y:double; demo:string; folder:string; }
table ProjectCopy { project_path:string; items:[ProjectCopyItem]; copy_connections:bool; }
table ProjectImport { project_path:string; path:string (required); id:string (required); x:double; y:double; }
table ProjectCreateCard { project_path:string; id:string (required); template:string (required); name:string; x:double; y:double; automatic_placement:bool; }
enum ProjectLayoutAction:ubyte { Arrange, Untangle }
table ProjectLayout {
  project_path:string;
  action:ProjectLayoutAction;
  // Measurements only; the host uses the current graph and saved positions.
  scene:LayoutScene;
}
table ProjectMove {
  project_path:string; cards:[string]; notes:[string]; frames:[string];
  dx:double; dy:double; snap:double; scene:LayoutScene;
}
table ProjectDocument { path:string (required); present:bool = true; json:string; }
// Raw editors refuse every stale revision, including unrelated changes.
table ProjectReplaceDocuments { expected_rev:ulong; documents:[ProjectDocument]; }
enum ProjectSelectionAction:ubyte { Place, Delete, DeleteDefinitions, DisconnectInputs, DisconnectOutputs, RemoveConnections }
table ProjectSelection { project_path:string; action:ProjectSelectionAction; cards:[string]; notes:[string]; frames:[string]; connections_json:string; x:double; y:double; scene:LayoutScene; }
table ProjectReload { expected_rev:ulong; approved_permissions:[string]; }
union ProjectOperationBody { ProjectEdits, ProjectConnect, ProjectMakeSubgraph, ProjectLayout, ProjectCopy, ProjectImport, ProjectCreateCard, ProjectMove, ProjectReplaceDocuments, ProjectSelection, ProjectReload }
table ProjectOperateRequest {
  project_id:string (required);
  op_id:string (required);
  body:ProjectOperationBody;
}
table ProjectOperationResult { reply:Tsugumi.RPC.Reply (required); }

// Host policy owns the permission catalog. Unknown ids must still be displayed
// verbatim by clients, and cannot become standing approvals implicitly.
table PermissionKindsRequest { language:string; }
table PermissionKinds { kinds:[Tsugumi.Service.PermissionKind]; }

// One app-wide native session ("desktop") or one session per Web host
// ("web:<support directory>"), shared by every window. Language is presentation.
// Persisted: setup_done, demo_answered, tour. The live step/run observations
// last for the hostd lifetime. No model configuration is needed.
table GuideTour { demo:string (required); title:string (required); path:string (required); started:bool; }
table GuideAction { kind:string (required); label:string (required); demo:string; card:string; }
table GuideGetRequest { session_id:string (required); language:string; }
// kind: connection, setup, introduction, offered, start, end, resume,
// message, interest, observe, action_finished. Clients report screen facts;
// only hostd chooses a script step. expected_step guards stale choices.
table GuideInput {
  kind:string (required); text:string; project:string; demo:string; title:string;
  connected:bool; active:bool; run:string; state:string; scripted:bool = true;
  expected_step:string;
}
table GuideAdvanceRequest { session_id:string (required); language:string; event:GuideInput (required); }
table GuideState {
  session_id:string (required); revision:ulong; answer_revision:ulong; setup_done:bool; demo_answered:bool;
  tour:GuideTour; step:string; text:string; say:string; choices:[string];
  actions:[GuideAction]; highlight:string; open:string; end_tour:bool;
  // present is true only for a new answer; note is the model-mode cue
  // (start/resume/run/disconnected/reconnected), with its display text in asked.
  present:bool; note:string; asked:string; project:string;
}

// Execution services contain public pins only. Private TLS keys never cross RPC.
table ExecutionServicesRequest {}
table ExecutionServicePutRequest { id:string (required); name:string (required); endpoint:string (required); worker_public_key:string (required); verify:bool; grade:ulong = 1; }
table ExecutionServiceRemoveRequest { id:string (required); }
// hostd derives identity from the host filesystem, never the document UUID.
// hostd writes the scoped capability into this project's control share.
table ExecutionProjectAuthorizeRequest { project_id:string (required); path:string (required); control_dir:string (required); guest:bool; }
table ExecutionProjectRevokeRequest { project_id:string (required); }
table ExecutionCapabilities { server_id:string (required); native_system:string (required); systems:[string]; isolation:string; resource_limits:bool; max_concurrent_jobs:uint; worker_contract:uint; }
table ExecutionService { id:string (required); name:string (required); endpoint:string (required); worker_public_key:string (required); capabilities:ExecutionCapabilities (required); grade:ulong = 1; }
table ExecutionServices { services:[ExecutionService]; host_public_key:string (required); }
table ExecutionAuthorization { endpoint:string (required); capability_file:string (required); available:bool; }

table ProjectDefaults { nixpkgs_pin:string (required); agent_exclude:[string]; }
table ProjectInfo { path:string (required); name:string (required); }
table ProjectLocation { path:string (required); }
// opened_at is Unix epoch milliseconds. Forget never removes project folders.
table RecentProject { path:string (required); name:string (required); opened_at:long; }
table RecentList { projects:[RecentProject]; }
table Demo { id:string (required); path:string (required); title:string (required); description:string (required); tags:[string]; field:string; }
table DemoList { demos:[Demo]; }
table Model { id:string; name:string; }
table ModelList { models:[Model]; }
// ---- Layout ----------------------------------------------------------------------
// Arrange and Untangle Wires are worked out here, once, for every client. A
// client says what its canvas draws in one scope (a Card's size and where its
// ports are depend on how the window draws them and on its grid), the answer is
// a proposal, and the client saves it with ProjectSave as one edit, as it saves
// any change of layout.json. Nothing is read from or written to the document.

table LayoutPort {
  name:string (id: 0, required);
  /// Where the port is on its Card, from the Card's top-left corner.
  x:double (id: 1);
  y:double (id: 2);
}

table LayoutCard {
  id:string (id: 0, required);
  /// Where the Card is drawn now (on the grid, when the grid moves it there).
  x:double (id: 1);
  y:double (id: 2);
  width:double (id: 3);
  height:double (id: 4);
  /// In the order drawn.
  inputs:[LayoutPort] (id: 5);
  outputs:[LayoutPort] (id: 6);
  /// Its ports may be drawn in another order (not those of a fork, a branch
  /// and the like, whose places have a meaning).
  reorderable:bool (id: 7);
}

table LayoutWire {
  from:string (id: 0, required);
  from_port:string (id: 1, required);
  to:string (id: 2, required);
  to_port:string (id: 3, required);
}

/// An output frame (`id` is its Card's) or a note, where it is drawn now.
table LayoutBox {
  id:string (id: 0, required);
  x:double (id: 1);
  y:double (id: 2);
  width:double (id: 3);
  height:double (id: 4);
}

/// A rectangle in Card-local coordinates. Anchors multiply the measured Card
/// width/height; x/y are world-unit offsets. Clients only transform coordinates.
table DisplayGeometry {
  anchor_x:double;
  anchor_y:double;
  x:double;
  y:double;
  width:double;
  height:double;
}
/// -> DisplayGeometries. Host-owned default output-frame geometry for both flows.
table DisplayGeometryRequest {}
table DisplayGeometries {
  top_to_bottom:DisplayGeometry (required);
  left_to_right:DisplayGeometry (required);
}

/// One port of a Card in Card and the inner Card it goes to or comes from.
table LayoutBarEnd {
  name:string (id: 0, required);
  card:string (id: 1, required);
  port:string (id: 2, required);
}

/// A bar of a Card in Card's inner canvas ("This Card's input" / "output").
table LayoutBar {
  ends:[LayoutBarEnd] (id: 0);
  /// Where the bar was put by hand; omitted while it follows the Cards.
  x:double = null (id: 1);
  y:double = null (id: 2);
}

/// What a canvas draws in one scope.
table LayoutScene {
  /// "topToBottom" or "leftToRight".
  flow:string (id: 0, required);
  /// The grid's spacing (frames, notes and layers go on it; 20 when 0).
  grid:double (id: 1);
  /// The grid is on: Cards are placed on it.
  snap:bool (id: 2);
  cards:[LayoutCard] (id: 3);
  wires:[LayoutWire] (id: 4);
  /// The output frames shown.
  frames:[LayoutBox] (id: 5);
  notes:[LayoutBox] (id: 6);
  /// Inside a Card in Card only.
  inputs:LayoutBar (id: 7);
  outputs:LayoutBar (id: 8);
}



/// The order a Card's ports are drawn in (layout.json's inputOrder / outputOrder).

/// What LayoutArrange or LayoutUntangle would change; the client saves it.

table VersionCanvasCard {
  id:string (id: 0, required);
  x:double (id: 1);
  y:double (id: 2);
  /// What it is, which decides its shape: trigger, input, fork, branch, merge,
  /// draft, subgraph or code.
  kind:string (id: 3, required);
  /// The ports a fork or merge fans over, which decide its width; 0 for others.
  fan:uint32 (id: 4);
  /// Folded on the canvas: only its header shows.
  collapsed:bool (id: 5);
}

table VersionCanvasWire {
  from:string (id: 0, required);
  to:string (id: 1, required);
}

/// A version's own Cards: Card in Card is one Card here. Saved positions, or
/// columns by depth when a Card has none.
table VersionCanvas {
  cards:[VersionCanvasCard] (id: 0);
  wires:[VersionCanvasWire] (id: 1);
  /// The way the Cards run: "leftToRight" or "topToBottom". Columns by depth
  /// are always leftToRight.
  flow:string (id: 2, required);
}

/// -> LayoutValidated. Validate before saving; removed_cards cleans deleted
/// Card references. The caller includes the returned JSON in the same save.
table LayoutValidateRequest { json:string (required); removed_cards:[string]; }
table LayoutValidated { json:string (required); }
/// Pure display derivation for one workflow. definitions_json maps Card ids to
/// their _card.json text. Same document yields the same places on every client.
/// The returned layout is presentation only; opening never saves it.
table LayoutCompleteRequest { project_json:string (required); layout_json:string (required); definitions_json:string (required); }
/// Add missing places and deletion cleanup to the caller's exact CAS save.
/// No write, retry or merge occurs here. The caller sends the returned save to
/// the core as its single transaction. Agent saves use the same implementation.
/// -> VersionCanvas. Draw the raw definition data and layout returned by the
/// project's VersionCanvasRequest; no document is changed.
table VersionCanvasRequest {
  layout_json:string (required);
  cards:[VersionCanvasCard];
  wires:[VersionCanvasWire];
}

/// A comment on a Card that a version or a save changed.
table VersionComment {
  card:string (id: 0, required);
  text:string (id: 1, required);
  /// added, edited, resolved, reopened or removed. A comment written and
  /// resolved within one version is resolved.
  change:string (id: 2, required);
  resolution:string (id: 3);
  /// Who did it, as the comment records it: agent or user. Absent when it is
  /// not recorded, as for a comment that is gone.
  by:string (id: 4);
  /// The Cards the save that resolved it changed.
  cards:[string] (id: 5);
}

// The host reads comment records from the registered project repository.
table VersionCommentsRequest { project:string (required); commit:string (required); }
table VersionComments { comments:[VersionComment]; }

/// -> InputTypes. Read each incoming wire's source, kind and complete input
/// definition as Card code sees it. May help when writing a Card; routing types
/// are resolved automatically. language defaults to the Card implementation;
/// pass it for a Draft, or "schema" for plain tables. output_port selects
/// one upstream output instead. No result size limit.
table InputTypesRequest {
  project:string (required);
  card:Tsugumi.Data.CardPath (required);
  output_port:string;
  language:string;
  at_rev:ulong = null;
}
table InputType {
  port:string (required);
  source_card:Tsugumi.Data.CardPath;
  source_port:string;
  /// value, file or directory; empty when unresolved.
  kind:string;
  /// no_source, unresolved or resolved.
  state:string (required);
  definition:string;
}
table InputTypes { rev:ulong = null; language:string; inputs:[InputType]; }

// Pure editing support: paths select a language and label diagnostics, never files.
table FileFormatRequest { path:string (required); text:string (required); language:Tsugumi.Data.FormatLanguage; }
table FileFormatResult { text:string (required); diagnostics:[Tsugumi.Data.Diagnostic]; }
// Language applies on every read, including commits/runs created by another client.
table HostVersionDiffRequest { project:string (required); commit:string (required); from_commit:string; }
table VersionDiff { text:string (required); truncated:bool; }
table HostVersionGraphRequest { project:string (required); language:string; limit:uint = 500; }

// Reference demos and version notes do not depend on a conversation.
table DemoListRequest {}
table DemoReadRequest { path:string (required); }
table VersionNoteRequest { project_id:string (required); commit:string (required); profile:string (required); language:string (required); anthropic_key_profile:string; openai_key_profile:string; }
table DemoPaths { paths:[string]; }

// Reserve an annotation reference across all clients of the project. kind is
// note, group or comment; comments supply their Card path as scope. occupied
// carries the client's existing document IDs. Absence means an empty list.
table IdentifierReserveRequest { project_id:string (required); kind:string (required); scope:string; occupied:[string]; }
table Identifier { id:string (required); }

union RequestPayload {
  VersionCommentsRequest, ProjectPermissionsRequest, ProjectPermissionSetRequest,
  BinaryCachesGetRequest, BinaryCachesPutRequest, GuideGetRequest, GuideAdvanceRequest, HelloRequest:Tsugumi.Service.HelloRequest, EnvironmentRequest, HostRuntimeRequest, HostTerminalRequest, SettingsGetRequest, SettingsUpdateRequest, ProviderSetRequest, ProviderStatusRequest, SignInBeginRequest, SignInActionRequest, SignInStatusRequest,
  ExecutionServicesRequest, ExecutionServicePutRequest, ExecutionServiceRemoveRequest, ExecutionProjectAuthorizeRequest, ExecutionProjectRevokeRequest,
  RegisterProjectRequest, RegisterFolderRequest, AttachFoldersRequest, SkillsListRequest, ProjectTrustRequest, ModelsListRequest, HostProjectDefaultsRequest, HostProjectInfoRequest, HostProjectCreateRequest, HostProjectDuplicateRequest, HostDemoListRequest, HostDemoCopyRequest, HostRecentListRequest, HostRecentRememberRequest, HostRecentForgetRequest,
  LayoutValidateRequest, VersionCanvasRequest,
  FileFormatRequest, HostVersionGraphRequest, HostVersionDiffRequest,
  PermissionKindsRequest,
  ProjectOperateRequest,

  ModelSelectionRequest,
  DemoListRequest, DemoReadRequest, VersionNoteRequest, DisplayGeometryRequest, LayoutCompleteRequest, IdentifierReserveRequest, InputTypesRequest, HostActivityRequest
}
table Request { value:RequestPayload; }
union ReplyPayload {
  ProjectOperationResult, ProjectPermissionList,
  VersionComments,
  HelloResult:Tsugumi.Service.HelloResult, Acknowledgement:Tsugumi.Service.Acknowledgement,
  BinaryCaches, GuideState, EnvironmentState, AttachedFolders, HostRuntime, HostTerminal, ExecutionServices, ExecutionAuthorization, Settings, ProviderStatus, SignInBegin, SignInStatus, ProjectDefaults, ProjectInfo, ProjectLocation, RecentProject,
  RecentList, DemoList, SkillsList, ProjectTrust, ModelList, Failure:Tsugumi.Service.Failure,
  LayoutValidated, VersionCanvas,
  FileFormatResult, VersionDiff, VersionGraph:Tsugumi.RPC.VersionGraph,
  PermissionKinds,
  ModelSelection, DemoPaths, TextResult:Tsugumi.Service.TextResult, DisplayGeometries, Identifier, InputTypes, HostActivity
}
table Reply { value:ReplyPayload; }
union Payload { Request, Reply, Event }
table Message { request_id:ulong; payload:Payload; }
root_type Message;
file_identifier "TSH1";
